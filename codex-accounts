VERSION = '0.13.1'
# Bump only when live object state/protocol can no longer be adopted in place.
LIVE_RUNTIME_ABI = 1
ROOT = Path(os.environ.get('CODEX_ACCOUNTS_HOME', str(Path.home() / '.local/share/codex-accounts'))).expanduser().resolve()
BINARY = os.environ.get('CODEX_ACCOUNTS_BINARY', 'codex')
NAME = re.compile(r'^[a-zA-Z0-9][a-zA-Z0-9_-]{0,39}$')
# Ambient credentials must never override the selected ChatGPT account.
AUTH_ENV = ('OPENAI_API_KEY', 'CODEX_API_KEY', 'CODEX_ACCESS_TOKEN',
            'OPENAI_IDENTITY_TOKEN_FILE', 'OPENAI_IDENTITY_PROVIDER_ID',
            'OPENAI_BASE_URL', 'CHATGPT_BASE_URL', 'CODEX_REMOTE_TOKEN',
            'CODEX_THREAD_ID', 'CODEX_SESSION_ID', 'CODEX_APP_TOOLS_PIPE_PATH',
            'CODEX_INTERNAL_ORIGINATOR_OVERRIDE')

class Error(Exception):
    pass

def private_dir(path):
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)

def atomic_json(path, value):
    private_dir(path.parent)
    fd, tmp = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(value, f, indent=2)
            f.write('\n')
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)

def read_json(path, default=None):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default

@contextlib.contextmanager
def lock(name, shared=False):
    private_dir(ROOT / 'locks')
    with (ROOT / 'locks' / (name + '.lock')).open('a') as f:
        try:
            fcntl.flock(f, (fcntl.LOCK_SH if shared else fcntl.LOCK_EX) | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Error('This account or conversation is busy. Close its active launcher session and retry.')
        yield

def account_home(name):
    if not NAME.fullmatch(name):
        raise Error('Account names must be 1–40 letters, digits, underscores or hyphens.')
    return ROOT / 'accounts' / name

def accounts():
    base = ROOT / 'accounts'
    return sorted(p.name for p in base.iterdir() if p.is_dir() and NAME.fullmatch(p.name)) if base.exists() else []

def require_account(name):
    home = account_home(name)
    if name not in accounts():
        raise Error('Unknown account. Connect it with: codex-accounts add ' + name)
    return home

# Only user configuration and explicitly identified capabilities are shared.
# Credentials, histories, databases, writer locks and temporary tool state stay
# in the selected account home. Never link the whole CODEX_HOME.
SHARED_DIRECTORIES = ('skills', 'plugins', 'rules', 'agents', 'prompts', 'hooks',
                      'automations', 'pets', 'packages', 'browser', 'computer-use')
SHARED_FILES = ('config.toml', 'AGENTS.md', 'hooks.json', 'installation_id', 'chrome-native-hosts-v2.json')
# Desktop materializes different catalogs for local and SSH hosts. Linking the
# generated directory lets SSH's smaller catalog replace the local catalog.
RETIRED_SHARED_DIRECTORIES = ('.tmp/bundled-marketplaces',)

@contextlib.contextmanager
def shared_lock():
    private_dir(ROOT / 'locks')
    with (ROOT / 'locks/shared.lock').open('a') as stream:
        # Two independent chats may start together; wait rather than rejecting
        # a valid account launch while the other installs its links.
        fcntl.flock(stream, fcntl.LOCK_EX)
        yield

def shared_settings():
    return read_json(ROOT / 'shared.json', {})

def validate_shared_home(raw):
    source = Path(raw).expanduser().resolve()
    isolated = (ROOT / 'accounts').resolve()
    if source == ROOT or source == isolated or isolated in source.parents or source in isolated.parents:
        raise Error('Shared home must be separate from launcher storage and account homes.')
    if source.exists() and not source.is_dir():
        raise Error('Shared Codex home must be a directory.')
    return source

def merge_missing(source, destination):
    """Union installed resources; canonical files win, including symlinks."""
    if not source.exists() and not source.is_symlink(): return
    if not destination.exists() and not destination.is_symlink():
        destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if source.is_symlink():
            resolved = source.resolve()
            if (ROOT / 'accounts').resolve() in resolved.parents:
                raise Error('Shared capability points into an account home: ' + str(source))
            try: destination.symlink_to(resolved)
            except FileExistsError: pass
        elif source.is_dir(): destination.mkdir(exist_ok=True, mode=0o700)
        else:
            descriptor, temporary = tempfile.mkstemp(prefix='.shared-copy-', dir=destination.parent)
            os.close(descriptor)
            try:
                shutil.copy2(source, temporary)
                # Atomic publication without overwriting a concurrent canonical
                # install. Interrupted copies never become canonical files.
                try: os.link(temporary, destination)
                except FileExistsError: pass
            finally: Path(temporary).unlink(missing_ok=True)
    if source.is_dir() and destination.is_dir() and not source.is_symlink() and not destination.is_symlink():
        for child in source.iterdir(): merge_missing(child, destination / child.name)

def shared_resource_names(source, home):
    names = list(SHARED_DIRECTORIES) + list(SHARED_FILES)
    names.extend(path.name for root in (source, home) for path in root.glob('*.config.toml'))
    return list(dict.fromkeys(names))

def retire_shared_resources(home, source, manifest_path, manifest):
    """Restore resources shared by older versions; retry interrupted restores."""
    entries = manifest['entries']
    for relative in RETIRED_SHARED_DIRECTORIES:
        entry = entries.get(relative)
        if entry is None: continue
        path, target = home / relative, source / relative
        backup = Path(entry['backup']) if entry.get('backup') else None
        linked = path.is_symlink() and path.resolve() == target.resolve()
        exists = path.exists() or path.is_symlink()
        backup_exists = backup and (backup.exists() or backup.is_symlink())
        restored = entry.get('restore_started') and not linked and (
            backup and not backup_exists and exists or not backup and not exists)
        unmoved = not entry.get('installed') and backup and not backup_exists and exists
        if not restored and not unmoved:
            if exists and not linked:
                raise Error('Shared path changed externally; preserve it before syncing: ' + str(path))
            if backup and not backup_exists:
                raise Error('Original shared-path backup is missing: ' + str(backup))
            entry['restore_started'] = True
            atomic_json(manifest_path, manifest)
            path.unlink(missing_ok=True)
            if backup_exists: os.replace(backup, path)
        del entries[relative]
        atomic_json(manifest_path, manifest)

def link_shared_home(name, source):
    home = require_account(name)
    manifest_path = ROOT / 'shared-links' / (name + '.json')
    manifest = read_json(manifest_path, {'home': str(source), 'entries': {}})
    if manifest['home'] != str(source):
        raise Error('Disable the current shared home before choosing another one.')
    retire_shared_resources(home, source, manifest_path, manifest)
    entries = manifest['entries']
    for relative in shared_resource_names(source, home):
        path, target = home / relative, source / relative
        if path.is_symlink() and path.resolve() == target.resolve():
            if relative in entries and not entries[relative].get('installed'):
                entries[relative]['installed'] = True
                atomic_json(manifest_path, manifest)
            continue
        previous = entries.get(relative)
        # Optional files are linked only when present; never fabricate native
        # host registrations or hook JSON. The config is always available.
        exists = path.exists() or path.is_symlink()
        if previous and exists:
            # Codex preserves these links when writing configuration. A
            # detached/repointed path belongs to the user; never overwrite it.
            backup = Path(previous['backup']) if previous.get('backup') else None
            if previous.get('installed') or not backup or backup.exists() or backup.is_symlink():
                raise Error('Shared path changed externally; preserve it before syncing: ' + str(path))
        if not target.exists() and not target.is_symlink() and not exists:
            if relative == 'config.toml':
                target.write_text('')
                target.chmod(0o600)
            elif relative in SHARED_DIRECTORIES:
                target.mkdir(parents=True, exist_ok=True, mode=0o700)
            else: continue
        if exists:
            # Do not read credentials from outside capability paths or follow
            # an existing capability link back into an account being replaced.
            if path.is_symlink():
                resolved = path.resolve()
                if (ROOT / 'accounts').resolve() in resolved.parents:
                    raise Error('Shared capability points into an account home: ' + relative)
            merge_missing(path, target)
        if target.is_symlink() and (ROOT / 'accounts').resolve() in target.resolve().parents:
            raise Error('Canonical capability points into an account home: ' + relative)
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        backup = Path(previous['backup']) if previous and previous.get('backup') else None
        if exists and backup is None:
            backup = ROOT / 'shared-backups' / name / str(uuid.uuid4()) / relative
            private_dir(backup.parent)
        # Record the recovery location before changing either path. A partial
        # migration can be retried or undone without losing the original.
        entries[relative] = {'backup': str(backup) if backup else None, 'installed': False}
        atomic_json(manifest_path, manifest)
        if backup and exists: os.replace(path, backup)
        temporary = path.with_name('.' + path.name + '.shared-' + uuid.uuid4().hex)
        try:
            temporary.symlink_to(target, target_is_directory=relative in SHARED_DIRECTORIES)
            os.replace(temporary, path)
            entries[relative]['installed'] = True
            atomic_json(manifest_path, manifest)
        finally:
            temporary.unlink(missing_ok=True)
    return len(entries)

def prepare_shared_home(name):
    settings = shared_settings()
    if not settings.get('enabled'): return
    with shared_lock():
        settings = shared_settings()
        if settings.get('enabled'):
            if settings.get('restoring'):
                raise Error('Run shared off to finish restoring account capabilities before launching.')
            source = validate_shared_home(settings['home'])
            source.mkdir(parents=True, exist_ok=True, mode=0o700)
            link_shared_home(name, source)

def disable_shared_home():
    settings = shared_settings()
    if not settings.get('enabled'): return
    source = validate_shared_home(settings['home'])
    # Validate before detaching anything. External edits must be preserved.
    restores = []
    for name in accounts():
        manifest_path = ROOT / 'shared-links' / (name + '.json')
        manifest = read_json(manifest_path, {})
        for relative, entry in manifest.get('entries', {}).items():
            if entry.get('restored'): continue
            path = require_account(name) / relative
            backup = Path(entry['backup']) if entry.get('backup') else None
            linked = path.is_symlink() and path.resolve() == (source / relative).resolve()
            # A restore may have consumed its backup before the completion
            # record was written. Keep the restored path on a retry.
            if entry.get('restore_started') and not linked:
                if backup and not (backup.exists() or backup.is_symlink()) and (path.exists() or path.is_symlink()): continue
                if not backup and not (path.exists() or path.is_symlink()): continue
            if path.exists() or path.is_symlink():
                if not linked:
                    if not entry.get('installed') and backup and not (backup.exists() or backup.is_symlink()):
                        continue  # Backup move never occurred; original remains.
                    raise Error('Shared path changed externally; preserve it before disabling: ' + str(path))
            if backup and not (backup.exists() or backup.is_symlink()):
                raise Error('Original shared-path backup is missing: ' + str(backup))
            restores.append((path, backup, manifest_path, manifest, entry))
    atomic_json(ROOT / 'shared.json', {**settings, 'restoring': True})
    for path, backup, manifest_path, manifest, entry in restores:
        entry['restore_started'] = True
        atomic_json(manifest_path, manifest)
        path.unlink(missing_ok=True)
        if backup and (backup.exists() or backup.is_symlink()): os.replace(backup, path)
        entry['restored'] = True
        atomic_json(manifest_path, manifest)
    for name in accounts(): (ROOT / 'shared-links' / (name + '.json')).unlink(missing_ok=True)
    atomic_json(ROOT / 'shared.json', {**settings, 'enabled': False, 'restoring': False})

def shared_capabilities(operation='status', source_home=None, as_json=False):
    if source_home is not None and operation != 'sync':
        raise Error('--source-home is only supported with shared sync.')
    if operation != 'status':
        with shared_lock():
            if operation == 'off': disable_shared_home()
            else:
                settings = shared_settings()
                if settings.get('restoring'):
                    raise Error('Run shared off to finish restoring account capabilities before syncing.')
                source = validate_shared_home(source_home or settings.get('home') or Path.home() / '.codex')
                if settings.get('enabled') and Path(settings['home']) != source:
                    raise Error('Run shared off before choosing another source home.')
                source.mkdir(parents=True, exist_ok=True, mode=0o700)
                atomic_json(ROOT / 'shared.json', {'enabled': True, 'home': str(source)})
                for name in accounts(): link_shared_home(name, source)
    settings = shared_settings()
    result = {'enabled': bool(settings.get('enabled')), 'home': settings.get('home'),
              'accounts': accounts(), 'resources': list(SHARED_DIRECTORIES) + list(SHARED_FILES)}
    result['profiles'] = {}
    if result['enabled']:
        source = validate_shared_home(settings['home'])
        for name in accounts():
            home = require_account(name)
            linked, pending = [], []
            for relative in shared_resource_names(source, home):
                path, target = home / relative, source / relative
                if relative not in SHARED_DIRECTORIES and relative != 'config.toml' and not (target.exists() or path.exists() or path.is_symlink()):
                    continue
                if path.is_symlink() and path.resolve() == target.resolve(): linked.append(relative)
                else: pending.append(relative)
            result['profiles'][name] = {'linked': linked, 'pending': pending}
    if as_json: print(json.dumps(result, indent=2))
    else:
        print('Shared Codex capabilities: ' + ('enabled' if result['enabled'] else 'disabled'))
        if result['home']: print('Source home: ' + result['home'])
        if result['enabled']:
            ready = sum(not profile['pending'] for profile in result['profiles'].values())
            print('Linked profiles: ' + str(ready) + '/' + str(len(result['accounts'])))
        if operation == 'sync':
            print('Existing profiles linked; new accounts and replacement backends inherit the same capabilities.')
            print('Original profile resources are retained in shared-backups. Running backends keep loaded settings until reopened.')
        if operation == 'off': print('Original account resources restored. Shared source files remain available.')
    return result

def environment(name):
    prepare_shared_home(name)
    env = os.environ.copy()
    for key in AUTH_ENV:
        env.pop(key, None)
    env['CODEX_HOME'] = str(require_account(name))
    return env

def permission_args():
    mode = read_json(ROOT / 'permissions.json', {}).get('mode', 'default')
    if mode == 'yolo':
        return ['-c', 'approval_policy="never"', '-c', 'sandbox_mode="danger-full-access"']
    if mode != 'default':
        raise Error('Unknown shared permission mode. Use: codex-accounts permissions default|yolo')
    return []

def permissions(mode=None):
    if mode:
        with lock('permissions'):
            atomic_json(ROOT / 'permissions.json', {'mode': mode})
    current = read_json(ROOT / 'permissions.json', {}).get('mode', 'default')
    print('Shared launcher permissions: ' + current)
    if current == 'yolo':
        print('All launcher accounts: no approval prompts, unrestricted filesystem and network.')
    else:
        print('Use each account’s Codex configuration and project defaults.')
    if mode:
        print('Restart existing launcher sessions to apply. Desktop and other Codex processes are not changed.')

def model_args():
    settings = read_json(ROOT / 'defaults.json', {})
    result = []
    for key in ('model', 'model_reasoning_effort'):
        value = settings.get(key)
        if value is not None:
            if not isinstance(value, str) or not value.strip():
                raise Error('Invalid shared model defaults. Use codex-accounts defaults --clear.')
            result += ['-c', key + '=' + json.dumps(value)]
    return result

def defaults(model=None, effort=None, clear=False):
    with lock('defaults'):
        settings = {} if clear else read_json(ROOT / 'defaults.json', {})
        if model is not None:
            if not model.strip(): raise Error('Model cannot be empty.')
            settings['model'] = model
        if effort is not None: settings['model_reasoning_effort'] = effort
        if clear or model is not None or effort is not None:
            atomic_json(ROOT / 'defaults.json', settings)
    print('Shared launcher model defaults:')
    print(json.dumps(settings, indent=2) if settings else 'Use each account’s Codex configuration.')
    print('Applies to new launches across all accounts. --model and in-chat selections override defaults.')

def runtime_binary():
    """Keep packaged Codex helpers alive when a package manager removes a release.

    A running app-server resolves code-mode-host and resources lazily. Pin the
    complete declared package, not just its executable or a helper from a newer
    release. Unpackaged/custom entry points retain their existing behavior.
    """
    located = shutil.which(BINARY)
    if not located:
        raise Error('Codex CLI was not found on PATH. Install Codex first.')
    executable = Path(located).resolve()
    source = executable.parent.parent
    manifest = source / 'codex-package.json'
    if not manifest.is_file():
        return BINARY
    package = read_json(manifest)
    if package.get('layoutVersion') != 1 or package.get('entrypoint') != 'bin/codex':
        raise Error('Unsupported Codex package layout; cannot preserve its tool runtime.')
    if executable != source / 'bin/codex':
        return BINARY
    # Include file identities so reinstalling the same version creates a fresh
    # snapshot. Never garbage-collect these while old backends may still use them.
    entries = []
    for path in sorted(source.rglob('*')):
        st = path.stat()
        entries.append((str(path.relative_to(source)), st.st_size, st.st_mtime_ns, st.st_ino))
    identity = hashlib.sha256(json.dumps([str(source), entries]).encode()).hexdigest()
    cache = ROOT / 'native-runtimes'
    private_dir(cache)
    destination = cache / identity
    with (cache / '.lock').open('a') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        if not destination.exists():
            temporary = Path(tempfile.mkdtemp(prefix='.staging-', dir=cache))
            try:
                shutil.copytree(source, temporary / 'package', symlinks=False)
                # Detect removal/replacement during an upgrade before publishing.
                for relative, size, modified, inode in entries:
                    st = (source / relative).stat()
                    if (st.st_size, st.st_mtime_ns, st.st_ino) != (size, modified, inode):
                        raise Error('Codex changed during runtime capture. Retry after its update finishes.')
                os.replace(temporary / 'package', destination)
            finally:
                shutil.rmtree(temporary)
    return str(destination / 'bin/codex')

def command(*args, include_permissions=True):
    return [runtime_binary(), *args, '-c', 'cli_auth_credentials_store="file"',
            '-c', 'forced_login_method="chatgpt"', '-c', 'model_provider="openai"',
            *model_args(), *(permission_args() if include_permissions else [])]

def owners():
    return read_json(ROOT / 'owners.json', {})

def record_activity(sid, account, event, *, cwd=None, title=None, previous=None, key=None):
    """Record observations, not inferred billing. Audit failure must not stop a turn."""
    try:
        private_dir(ROOT)
        with contextlib.closing(sqlite3.connect(ROOT/'activity.sqlite', timeout=5)) as db:
            db.execute('CREATE TABLE IF NOT EXISTS events (key TEXT PRIMARY KEY, timestamp REAL NOT NULL, session TEXT, account TEXT NOT NULL, event TEXT NOT NULL, cwd TEXT, title TEXT, previous_account TEXT)')
            db.execute('CREATE INDEX IF NOT EXISTS events_session ON events(session, timestamp)')
            db.execute('INSERT OR IGNORE INTO events VALUES (?,?,?,?,?,?,?,?)',
                       (key or str(uuid.uuid4()), time.time(), sid, account, event, cwd,
                        clean_text(title)[:200] if title else None, previous))
            db.commit()
    except (OSError, sqlite3.Error):
        print('codex-accounts: could not record account activity; conversation can continue.', file=sys.stderr)

def activity_records():
    path = ROOT/'activity.sqlite'
    if not path.exists(): return []
    with contextlib.closing(sqlite3.connect(path.as_uri()+'?mode=ro', uri=True)) as db:
        db.row_factory = sqlite3.Row
        return [dict(r) for r in db.execute('SELECT * FROM events ORDER BY timestamp, key')]

def session_records(account=None):
    ownership = owners()
    result = []
    for name in ([account] if account else accounts()):
        home = require_account(name)
        for path in (home / 'sessions').rglob('*.jsonl'):
            try:
                with path.open() as f:
                    line = f.readline(1024 * 1024)
                meta = json.loads(line)
                if meta.get('type') != 'session_meta':
                    continue
                meta = meta['payload']
                sid = str(uuid.UUID(meta['id']))
                if ownership.get(sid, name) != name:
                    continue
                result.append(dict(id=sid, account=name, cwd=meta.get('cwd', ''),
                                   history_mode=meta.get('history_mode', 'legacy'),
                                   title=session_title(path),
                                   modified=path.stat().st_mtime, path=str(path)))
            except (OSError, ValueError, KeyError):
                continue
    return sorted(result, key=lambda row: row['modified'], reverse=True)

def session_title(path):
    # Read only the beginning; never scan megabytes of tool output for a title.
    with path.open() as f:
        for line in f.read(262144).splitlines():
            try:
                item = json.loads(line)
                payload = item.get('payload', {})
                if item.get('type') == 'event_msg' and payload.get('type') == 'item_completed':
                    message = payload.get('item') or {}
                    if message.get('type') == 'UserMessage':
                        value = ' '.join(x.get('text', '') for x in message.get('content', []) if x.get('type') == 'text')
                        if value.strip() and not value.lstrip().startswith('<'):
                            return clean_text(' '.join(value.split()))[:90]
                if item.get('type') == 'event_msg' and payload.get('type') == 'user_message':
                    value = payload.get('message', '')
                    if isinstance(value, str) and value.strip() and not value.lstrip().startswith('<'):
                        return ' '.join(value.split())[:90]
            except ValueError:
                continue
    return '(untitled)'

def pick(rows, label, describe):
    if not rows:
        raise Error('No ' + label + ' found.')
    if not sys.stdin.isatty():
        raise Error('Specify a selection explicitly; the picker needs an interactive terminal.')
    for i, row in enumerate(rows, 1):
        print(f'{i:>3}. {describe(row)}')
    value = input('Choose number (Enter to cancel): ').strip()
    if not value:
        raise Error('Cancelled.')
    if not value.isdigit() or not 1 <= int(value) <= len(rows):
        raise Error('Invalid selection.')
    return rows[int(value) - 1]

def choose_account(name=None):
    if name:
        require_account(name)
        return name
    names = accounts()
    if not names:
        raise Error('Connect your first account: codex-accounts add personal')
    if len(names) == 1:
        return names[0]
    return pick(names, 'accounts', lambda n: n)

def describe_session(row):
    when = dt.datetime.fromtimestamp(row['modified']).strftime('%m-%d %H:%M')
    return f"{row['id']}  {row['account']:<12} {when}  {row['title']}\n     {row['cwd']}"

def choose_session(sid=None, account=None):
    rows = session_records(account)
    if not sid:
        return pick(rows, 'saved conversations', describe_session)
    matches = [r for r in rows if r['id'].startswith(sid)]
    if len(matches) != 1:
        raise Error('Session ID must uniquely match a saved conversation; use codex-accounts sessions.')
    return matches[0]

def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True

def active_runs():
    runs = []
    for path in (ROOT / 'runs').glob('*.json'):
        row = read_json(path)
        if row and alive(row['pid']):
            runs.append(row)
    return runs

def guard_idle(row):
    for run in active_runs():
        if run['account'] == row['account'] and (run['session'] == row['id'] or run['session'] is None):
            raise Error('The conversation may still be running. Close the source CLI first. '
                        'New sessions on this account must also be closed before moving history.')

def login(name, device=False, create=False):
    home = account_home(name)
    if create:
        if home.exists():
            raise Error('Account name already exists. Reconnect with: codex-accounts login ' + name)
        private_dir(home)
    else:
        require_account(name)
    with lock('account-' + name):
        print(f'Connecting {name}. Select its ChatGPT account in the browser.', flush=True)
        args = ['login'] + (['--device-auth'] if device else [])
        status = subprocess.call(command(*args), env=environment(name))
        if status:
            raise Error(f'Login did not finish (exit {status}). Retry: codex-accounts login {name}')
        if not (home / 'auth.json').is_file():
            raise Error('Codex did not save file-based credentials. Check managed authentication settings.')
        (home / 'auth.json').chmod(0o600)
        print(f'Connected. Start with: codex-accounts run {name}')

def run(name, row=None, prompt=None, cwd=None, model=None):
    home = require_account(name)
    if not (home / 'auth.json').is_file():
        raise Error('Account has no cached login. Run: codex-accounts login ' + name)
    working = Path(cwd or (row and row['cwd']) or os.getcwd()).expanduser().resolve()
    if not working.is_dir():
        raise Error('Project directory does not exist: ' + str(working))
    with contextlib.ExitStack() as stack:
        stack.enter_context(lock('account-' + name, shared=True))
        if row:
            stack.enter_context(lock('session-' + row['id']))
            if owners().get(row['id'], name) != name:
                raise Error('This conversation has moved. Run resume again to use its current account.')
        args = ['resume', row['id']] if row else []
        args += ['--no-daemon', '--cd', str(working)]
        if model:
            args += ['--model', model]
        cmd = command(*args)
        if prompt:
            cmd += ['--', prompt]
        private_dir(ROOT / 'runs')
        marker = ROOT / 'runs' / (str(uuid.uuid4()) + '.json')
        atomic_json(marker, dict(pid=os.getpid(), account=name, session=row['id'] if row else None,
                                 cwd=str(working), started=time.time(), mode='manual',
                                 phase='CLI open; turn state unknown', model=model,
                                 title=(row or {}).get('title') or prompt))
        print(f'Account: {name} · Project: {working}', flush=True)
        record_activity(row['id'] if row else None, name, 'manual_opened', cwd=str(working),
                        title=(row or {}).get('title') or prompt)
        try:
            return subprocess.call(cmd, env=environment(name), cwd=working)
        finally:
            marker.unlink(missing_ok=True)

@contextlib.contextmanager
def history_writer_lock(home, sid):
    # Coordinate with Codex's own per-thread writer lock, including clients
    # launched outside this wrapper. Never copy a live writer's rollout.
    directory = home / 'thread-writer-locks'
    private_dir(directory)
    with (directory / (sid + '.lock')).open('a') as stream:
        try:
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Error('Codex is using this conversation. Stop it before moving its history.')
        yield

@contextlib.contextmanager
def reset_history_projection(home, sid):
    # Paginated messages are durable in the rollout. These tables are derived
    # indexes: Codex rebuilds them on resume. Invalidate ONLY this thread so an
    # older destination copy cannot mask newly copied turns on a round trip.
    databases = list(home.glob('thread_history_*.sqlite'))
    if not databases:
        yield
        return
    if len(databases) != 1 or databases[0].name != 'thread_history_1.sqlite':
        raise Error('Unsupported Codex history database version; no history was replaced.')
    db = sqlite3.connect(databases[0], timeout=5)
    try:
        db.execute('BEGIN IMMEDIATE')
        tables = {r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        expected = {'thread_turns', 'thread_items', 'thread_history_projection_state', 'thread_realtime_items'}
        if tables - expected - {'_sqlx_migrations', 'sqlite_sequence'}:
            raise Error('Unsupported Codex history schema; no history was replaced.')
        for table in sorted(tables & expected):
            columns = {r[1] for r in db.execute('PRAGMA table_info("' + table + '")')}
            if 'thread_id' not in columns:
                raise Error('Unsupported Codex history schema; no history was replaced.')
            db.execute('DELETE FROM "' + table + '" WHERE thread_id = ?', (sid,))
        yield
        db.commit()
    except BaseException:
        db.rollback()
        raise
    finally:
        db.close()

def move(row, target, already_locked=False, source_home=None, quiet=False):
    require_account(target)
    if row['account'] == target and source_home is None:
        raise Error('This conversation already uses that account.')
    if row['history_mode'] not in ('legacy', 'paginated'):
        raise Error('Unknown history format; no files were changed.')
    if not (require_account(target) / 'auth.json').is_file():
        raise Error('Connect the destination first: codex-accounts login ' + target)
    external = source_home is not None
    source_home = Path(source_home).resolve() if external else require_account(row['account'])
    source_lock = ('source-' + hashlib.sha256(str(source_home).encode()).hexdigest()[:24]
                   if external else 'account-' + row['account'])
    with lock(source_lock, shared=True), lock('account-' + target, shared=True), \
            (contextlib.nullcontext() if already_locked else lock('session-' + row['id'])), lock('registry'), \
            history_writer_lock(source_home, row['id']), \
            history_writer_lock(require_account(target), row['id']):
        guard_idle(row)
        if owners().get(row['id'], row['account']) != row['account']:
            raise Error('Conversation changed accounts; retry with its current location.')
        source = Path(row['path'])
        if not source.resolve().is_relative_to((source_home / 'sessions').resolve()):
            raise Error('History path is outside the source session directory.')
        existing = list((require_account(target) / 'sessions').rglob('*' + row['id'] + '.jsonl'))
        if len(existing) > 1:
            raise Error('Destination contains duplicate session histories; no files were changed.')
        dest = existing[0] if existing else require_account(target) / 'sessions' / 'imported' / source.name
        private_dir(dest.parent)
        # An existing destination can contain older history from an earlier move.
        # Keep a backup outside sessions before replacing it.
        backup = None
        if dest.exists():
            backup = ROOT / 'backups' / (str(uuid.uuid4()) + '.jsonl')
            private_dir(backup.parent)
            shutil.copy2(dest, backup)
        fd, temp = tempfile.mkstemp(dir=dest.parent)
        os.close(fd)
        replaced = False
        try:
            before = source.stat()
            shutil.copyfile(source, temp)
            after = source.stat()
            if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
                raise Error('Source changed while copying. Close the source session and retry.')
            with reset_history_projection(require_account(target), row['id']):
                os.replace(temp, dest)
                replaced = True
        except BaseException:
            if replaced:
                if backup:
                    shutil.copyfile(backup, dest)
                else:
                    dest.unlink(missing_ok=True)
            raise
        finally:
            if os.path.exists(temp):
                os.unlink(temp)
        ownership = owners()
        ownership[row['id']] = target
        atomic_json(ROOT / 'owners.json', ownership)
        record_activity(row['id'], target, 'imported' if external else ('auto_switched' if already_locked else 'moved'),
                        cwd=row.get('cwd'), title=row.get('title'),
                        previous='local (account unknown)' if external else row['account'])
    if not quiet:
        print(f"Moved {row['id']} from {row['account']} to {target}.")
        print('Original history retained. Continue with: codex-accounts resume ' + row['id'])

def local_chats(source_home=None):
    home = Path(source_home or os.environ.get('CODEX_ACCOUNTS_SOURCE_HOME', str(Path.home()/'.codex'))).expanduser().resolve()
    titles = {}
    database = home / 'state_5.sqlite'
    if database.exists():
        try:
            with contextlib.closing(sqlite3.connect(database.as_uri()+'?mode=ro', uri=True)) as db:
                columns = {r[1] for r in db.execute('PRAGMA table_info(threads)')}
                title_column = "COALESCE(NULLIF(name, ''), title)" if 'name' in columns else 'title'
                for sid, title, cwd in db.execute('SELECT id, '+title_column+', cwd FROM threads WHERE archived = 0'):
                    titles[sid] = (title, cwd)
        except sqlite3.Error:
            pass  # Rollout discovery works without the optional title index.
    result = []
    for path in (home/'sessions').rglob('*.jsonl'):
        try:
            if not path.resolve().is_relative_to((home/'sessions').resolve()): continue
            with path.open() as f: record = json.loads(f.readline(1024*1024))
            if record.get('type') != 'session_meta': continue
            meta = record['payload']
            if isinstance(meta.get('source'), dict): continue  # Child-agent histories are not standalone chats.
            sid = str(uuid.UUID(meta['id']))
            title, cwd = titles.get(sid, (None, None))
            result.append(dict(id=sid, account='local', source_home=str(home),
                               title=clean_text(title or session_title(path)), cwd=cwd or meta.get('cwd',''),
                               history_mode=meta.get('history_mode','legacy'),
                               path=str(path), modified=path.stat().st_mtime))
        except (OSError, ValueError, KeyError, TypeError):
            continue
    return result

def discover_chats(query='', source_home=None):
    managed = session_records()
    ids = {row['id'] for row in managed}
    rows = managed + [row for row in local_chats(source_home) if row['id'] not in ids]
    words = query.casefold().split()
    rows = [r for r in rows if all(word in (' '.join(str(r[k]) for k in ('id','title','cwd','account'))).casefold() for word in words)]
    return sorted(rows, key=lambda r:r['modified'], reverse=True)

def chat_description(row):
    source = 'Local Codex / Desktop (import)' if row.get('source_home') else row['account'] + ' (launcher)'
    when = dt.datetime.fromtimestamp(row['modified']).strftime('%m-%d %H:%M')
    return f"{clean_text(row['title'])[:100]} · {when}\n     {clean_text(row['cwd'])} · {source}"

def pick_chat_plain(rows):
    if not rows: raise Error('No matching local chats found. Try a different search or --source-home.')
    if not sys.stdin.isatty(): raise Error('Use continue --list to browse, then continue CHAT_ID in a terminal.')
    original, page = rows, 0
    while True:
        shown = rows[page*15:(page+1)*15]
        print(f'\nExisting chats · {len(rows)} matches · page {page+1}')
        for i,row in enumerate(shown,1): print(f'{i:>2}. {chat_description(row)}')
        value = input('Number to continue · text to filter · n next · / reset · Enter cancel: ').strip()
        if not value: raise Error('Cancelled.')
        if value == 'n': page = (page+1) % max(1,(len(rows)+14)//15); continue
        if value == '/': rows,page = original,0; continue
        if value.isdigit() and 1 <= int(value) <= len(shown): return shown[int(value)-1]
        words = value.casefold().split()
        rows = [r for r in original if all(w in (r['title']+' '+r['cwd']+' '+r['account']).casefold() for w in words)]
        page = 0

def terminal_text(text, width):
    if width <= 0: return ''
    if text is None or text == '': return ' ' * width
    result, used = '', 0
    for char in clean_text(text):
        size = 0 if unicodedata.combining(char) else (2 if unicodedata.east_asian_width(char) in ('W','F') else 1)
        if used + size > width:
            while result and used > width-1:
                tail = result[-1]; result = result[:-1]
                used -= 0 if unicodedata.combining(tail) else (2 if unicodedata.east_asian_width(tail) in ('W','F') else 1)
            result += '…'; used += 1
            break
        result += char; used += size
    return result + ' ' * max(0,width-used)

def filter_picker_rows(rows, query, scope, cwd):
    cwd = str(Path(cwd).resolve())
    words = query.casefold().split()
    return [r for r in rows
            if (scope != 'project' or str(Path(r['cwd']).resolve()) == cwd)
            and (scope != 'launcher' or not r.get('source_home'))
            and all(w in (r['title']+' '+r['cwd']+' '+r['account']).casefold() for w in words)]

def picker_screen(rows, query, scope, cwd, selected, height, width, runs):
    width = max(1,width-1)
    scopes = {'all':'All projects', 'project':'This project: '+Path(cwd).name, 'launcher':'Launcher chats'}
    lines = [(1, 'CODEX ACCOUNTS  /  Continue a chat', 'heading'),
             (2, scopes[scope]+f'  ·  {len(rows)} matches', 'muted'),
             (4, 'Search: '+(query or 'type a title, project or account…'), 'search')]
    count = max(1,height-15)
    start = max(0,selected-count+1)
    wide = width >= 90
    title_width = max(12,width-(48 if wide else 29))
    def columns(title, project, account, updated):
        if wide:
            return '  '+terminal_text(title,title_width)+'  '+terminal_text(project,18)+'  '+terminal_text(account,10)+'  '+updated
        return '  '+terminal_text(title,title_width)+'  '+terminal_text(account,9)+'  '+updated
    lines.append((6,columns('CHAT','PROJECT','ACCOUNT','UPDATED'),'muted'))
    for index,row in enumerate(rows[start:start+count],start):
        account = 'Local' if row.get('source_home') else row['account']
        title = ('● ' if row['id'] in runs else '')+row['title']
        updated = dt.datetime.fromtimestamp(row['modified']).strftime('%m-%d %H:%M')
        lines.append((7+index-start,columns(title,Path(row['cwd']).name,account,updated), 'selected' if index==selected else 'normal'))
    if not rows: lines.append((7,'  No matches. Change the search or press Tab to change the filter.','muted'))
    if rows:
        row = rows[selected]
        title_lines = textwrap.wrap(clean_text(row['title']),max(1,width)) or ['(untitled)']
        lines += [(height-7, title_lines[0], 'heading'),
                  (height-6, title_lines[1] if len(title_lines)>1 else '', 'heading'),
                  (height-5,'Project: '+row['cwd'].replace(str(Path.home()),'~',1),'muted'),
                  (height-4, 'Local chat → terminal copy; Desktop messages do not sync.' if row.get('source_home') else
                   'Account: '+row['account']+' · '+(runs.get(row['id'],{}).get('phase') or 'saved chat')+' · quota checked before opening','muted')]
    lines += [(height-2,'↑↓ Move · Enter Open · Tab Filter · Esc Back','normal'),
              (height-1,'Type to search · Ctrl+U Clear · PgUp/PgDn','muted')]
    return [(y,terminal_text(text,width),style) for y,text,style in lines if 0 <= y < height]

def pick_chat(rows):
    if not rows: raise Error('No matching local chats found. Try a different search or --source-home.')
    if not sys.stdin.isatty(): raise Error('Use continue --list to browse, then continue CHAT_ID in a terminal.')
    if os.environ.get('TERM','dumb') == 'dumb' or not sys.stdout.isatty(): return pick_chat_plain(rows)
    try:
        import curses
    except ImportError:
        return pick_chat_plain(rows)
    cwd = str(Path.cwd().resolve())
    initial_scope = 'project' if filter_picker_rows(rows,'','project',cwd) else 'all'
    runs = {r['session']:r for r in active_runs() if r.get('session')}
    def interact(screen):
        screen.keypad(True)
        try: curses.curs_set(0)
        except curses.error: pass
        if curses.has_colors():
            curses.start_color()
            try: curses.use_default_colors(); curses.init_pair(1,curses.COLOR_CYAN,-1)
            except curses.error: pass
        query, selected, scope = '',0,initial_scope
        while True:
            height,width = screen.getmaxyx()
            filtered = filter_picker_rows(rows,query,scope,cwd)
            selected = min(selected,max(0,len(filtered)-1))
            screen.erase()
            if height < 18 or width < 45:
                try: screen.addnstr(0,0,'Enlarge terminal (45×18 minimum) or Esc to cancel.',max(1,width-1))
                except curses.error: pass
            else:
                for y,text,style in picker_screen(filtered,query,scope,cwd,selected,height,width,runs):
                    attr = curses.A_REVERSE | curses.A_BOLD if style=='selected' else curses.A_DIM if style=='muted' else curses.A_BOLD if style=='heading' else 0
                    if style=='heading' and curses.has_colors(): attr |= curses.color_pair(1)
                    try: screen.addstr(y,0,text,attr)
                    except curses.error: pass
            screen.refresh()
            key = screen.get_wch()
            if key in ('\x1b','\x03','\x04'): raise Error('Cancelled.')
            if key in ('\n','\r',curses.KEY_ENTER):
                if filtered and height>=18 and width>=45: return filtered[selected]
            elif key in (curses.KEY_UP,curses.KEY_DOWN):
                selected = max(0,min(len(filtered)-1,selected+(-1 if key==curses.KEY_UP else 1)))
            elif key in (curses.KEY_PPAGE,curses.KEY_NPAGE):
                selected = max(0,min(len(filtered)-1,selected+(-1 if key==curses.KEY_PPAGE else 1)*max(1,height-14)))
            elif key == '\t':
                scopes = ['project','all','launcher']; scope=scopes[(scopes.index(scope)+1)%3]; selected=0
            elif key in (curses.KEY_BACKSPACE,'\x7f','\b'): query=query[:-1]; selected=0
            elif key == '\x15': query=''; selected=0
            elif isinstance(key,str) and key.isprintable(): query+=key; selected=0
    try:
        return curses.wrapper(interact)
    except curses.error:
        return pick_chat_plain(rows)

def quota_state(report):
    usage = report.get('usage') or {}
    if usage.get('ordinaryUsageAllowed') is False: return 'blocked'
    if usage.get('ordinaryUsageAllowed') is True: return 'available'
    return 'unknown'

def select_ready_account(reports, preferred=None, requested=None):
    if requested:
        matches = [r for r in reports if r['label'] == requested]
        if not matches: raise Error('Unknown account: ' + requested)
        if quota_state(matches[0]) == 'blocked': raise Error('That account is blocked by its live usage limits. Choose another account.')
        if matches[0]['identity'][2] != 'cached': raise Error('Reconnect this account with codex-accounts login ' + requested)
        return matches[0]
    available = [r for r in reports if quota_state(r) == 'available']
    if not available:
        raise Error('No account has confirmed available quota. Check codex-accounts status; use --account NAME explicitly if limits are unavailable.')
    return min(available, key=lambda r:(r['label'] != preferred, len(r.get('runs',[])), r.get('routing',{}).get('last_selected',0)))

def continue_chat(query='', account=None, source_home=None, list_only=False, as_json=False):
    rows = discover_chats(query, source_home)
    if list_only or as_json:
        if as_json: print(json.dumps(rows, indent=2))
        else:
            for row in rows: print(chat_description(row)+'\n     '+row['id'])
            if not rows: print('No matching local chats found.')
        return 0
    if not sys.stdin.isatty(): raise Error('Continue needs a terminal. Use --list or --json to inspect chats.')
    row = rows[0] if query and len(rows) == 1 else pick_chat(rows)
    if not Path(row['cwd']).is_dir(): raise Error('The chat’s project directory is missing: '+clean_text(row['cwd']))
    print('Checking connected accounts and live limits…', flush=True)
    reports = collect_status()
    selected = select_ready_account(reports, None if row.get('source_home') else row['account'], account)
    name = selected['label']
    print(f"Account: {name} · {selected['identity'][0]} · {quota_state(selected)}")
    for line in usage_lines(selected.get('usage'))[:2]: print('  '+line)
    if row.get('source_home'):
        print('Continuing a copy in the terminal. The original Desktop/local chat stays separate; later messages do not sync.')
        move(row, name, source_home=row['source_home'])
    elif row['account'] != name:
        move(row, name)
    print('Automatic account switching: ON for this terminal chat.', flush=True)
    # A current successful quota check supersedes a stale launcher cooldown.
    if quota_state(selected) == 'available':
        with routing_state() as state: state.setdefault(name,{})['retry_after'] = 0
    return auto_run(account=name, session=row['id'])

def menu():
    if not accounts():
        if not sys.stdin.isatty():
            raise Error('Connect your first account: codex-accounts add personal')
        login(input('Name your first account (e.g. personal): ').strip(), create=True)
        return 0
    action = pick(['Continue an existing chat', 'Automatic account routing', 'Start a conversation', 'Resume a conversation', 'Move a conversation',
                   'Connect another account', 'Set up Codex Desktop', 'Conversation overview', 'Account status', 'List accounts'], 'actions', str)
    if action == 'Continue an existing chat':
        return continue_chat()
    elif action == 'Automatic account routing':
        return auto_run()
    elif action == 'Set up Codex Desktop':
        return open_setup_window()
    elif action == 'Connect another account':
        login(input('Account name: ').strip(), create=True)
    elif action == 'Account status':
        return show_status(watch=True)
    elif action == 'Conversation overview':
        return show_overview()
    elif action == 'Start a conversation':
        return run(choose_account())
    elif action == 'Resume a conversation':
        row = choose_session()
        return run(row['account'], row)
    elif action == 'Move a conversation':
        row = choose_session()
        move(row, choose_account())
    else:
        list_accounts()
    return 0

def account_snapshot(name, timeout=8, include_usage=False):
    """Ask Codex for cached identity, without refreshing or exposing credentials."""
    with lock('account-' + name, shared=True):
        backend = Backend(name)
        deadline = time.monotonic() + timeout
        def request(ident, method, params):
            backend.send(dict(id=ident, method=method, params=params))
            while time.monotonic() < deadline:
                while backend.messages:
                    message = backend.messages.popleft()
                    if message.get('id') == ident:
                        if 'error' in message:
                            raise Error('Account identity unavailable.')
                        return message.get('result', {})
                if select.select([backend.process.stdout], [], [], .1)[0]:
                    backend.read()
            raise Error('Account identity lookup timed out.')
        try:
            request(1, 'initialize', {'clientInfo': {'name': 'codex_accounts_identity', 'version': VERSION}})
            backend.send({'method': 'initialized'})
            account = request(2, 'account/read', {'refreshToken': False}).get('account')
            report = dict(identity=('—', '—', 'needs login'), usage=None, usage_error=None, checked_at=time.time())
            if not account:
                report['usage_error'] = 'No ChatGPT login'
                return report
            if account.get('type') != 'chatgpt':
                report['identity'] = ('—', '—', 'not a ChatGPT login')
                report['usage_error'] = 'No ChatGPT login'
                return report
            def clean(value):
                return ''.join(c for c in str(value or '—') if c.isprintable())
            report['identity'] = (clean(account.get('email')), clean(account.get('planType')), 'cached')
            if include_usage:
                try:
                    report['usage'] = request(3, 'account/rateLimits/read', {})
                    report['checked_at'] = time.time()
                except (Error, OSError, ValueError):
                    report['usage_error'] = 'Could not fetch live limits; check login or connection'
            return report
        finally:
            backend.close()

def account_identity(name, timeout=8):
    return account_snapshot(name, timeout=timeout)['identity']

def clean_text(value):
    return ''.join(c for c in str('—' if value is None or value == '' else value) if c.isprintable())

def duration(seconds):
    minutes = max(0, int(seconds)) // 60
    days, minutes = divmod(minutes, 1440)
    hours, minutes = divmod(minutes, 60)
    if days: return f'{days}d' + (f' {hours}h' if hours else '')
    if hours: return f'{hours}h' + (f' {minutes}m' if minutes else '')
    return f'{minutes}m'

def reset_text(timestamp):
    if not isinstance(timestamp, (int, float)):
        return 'reset unknown'
    local = dt.datetime.fromtimestamp(timestamp).astimezone().strftime('%a %H:%M %Z')
    if timestamp <= time.time():
        return f'reset time passed ({local}); refresh to check'
    return f'resets {local} (in {duration(timestamp - time.time())})'

def usage_lines(usage):
    if usage is None:
        return ['Limits unavailable']
    lines = []
    allowed = usage.get('ordinaryUsageAllowed')
    if allowed is False:
        lines.append('Included usage: blocked by backend')
    elif allowed is True:
        lines.append('Included usage: allowed by backend')
    buckets = usage.get('rateLimitsByLimitId') or {}
    if not buckets:
        fallback = usage.get('rateLimits')
        buckets = {(fallback or {}).get('limitId') or 'codex': fallback} if fallback else {}
    for key, bucket in buckets.items():
        if not isinstance(bucket, dict): continue
        label = clean_text(bucket.get('limitName') or key)
        for name in ('primary', 'secondary'):
            window = bucket.get(name)
            if not isinstance(window, dict): continue
            used = window.get('usedPercent')
            mins = window.get('windowDurationMins')
            window_label = duration(mins * 60) if isinstance(mins, (int, float)) else name
            if isinstance(used, (int, float)):
                left = max(0, min(100, 100 - used))
                blocks = int(left / 10)
                meter = '[' + '#' * blocks + '-' * (10-blocks) + ']'
                amount = f'{meter} {left:g}% left ({used:g}% used)'
            else:
                amount = 'usage unknown'
            lines.append(f'{label} · {window_label}: {amount} · {reset_text(window.get("resetsAt"))}')
        reason = bucket.get('rateLimitReachedType')
        if reason: lines.append(f'{label}: {clean_text(reason).replace("_", " ")}')
        if bucket.get('spendControlReached') is True:
            lines.append(f'{label}: spending limit reached')
        individual = bucket.get('individualLimit')
        if individual:
            remaining = individual.get('remainingPercent')
            lines.append(f'{label} · spending allowance: {remaining if remaining is not None else "unknown"}% left · '
                         + reset_text(individual.get('resetsAt')))
        credits = bucket.get('credits')
        if isinstance(credits, dict):
            balance = 'unlimited' if credits.get('unlimited') else clean_text(credits.get('balance'))
            lines.append(f'{label} · workspace credits: {balance} (may be shared across accounts)')
    resets = usage.get('rateLimitResetCredits')
    if isinstance(resets, dict) and resets.get('availableCount') is not None:
        lines.append(f'Earned resets available: {resets["availableCount"]}')
    return lines or ['Limits unavailable (backend returned no quota windows)']

def collect_status(account=None):
    names = [account] if account else accounts()
    if account: require_account(account)
    runs = active_runs()
    routing = read_json(ROOT / 'routing.json', {})
    def collect(name):
        report = dict(identity=('—', '—', 'needs login'), usage=None,
                      usage_error='No cached login', checked_at=time.time())
        if (require_account(name) / 'auth.json').is_file():
            try:
                report = account_snapshot(name, include_usage=True, timeout=12)
            except (Error, OSError, ValueError):
                report.update(identity=('—', '—', 'identity unavailable'),
                              usage_error='Could not read account; check login or connection')
        report.update(label=name, runs=[r for r in runs if r['account'] == name],
                      routing=routing.get(name, {}))
        return report
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=max(1, min(4, len(names)))) as pool:
        return list(pool.map(collect, names))

def conversation_overview(include_local=False):
    events = activity_records()
    rows = {r['id']:dict(r, stored_account=r['account'], activity=[], running=[], observed_accounts=[]) for r in session_records()}
    for event in events:
        sid = event['session']
        if not sid: continue  # Manual new-chat launches cannot be reliably assigned a thread ID.
        row = rows.setdefault(sid, dict(id=sid, title=event['title'] or '(untitled)', cwd=event['cwd'] or '',
                                       modified=event['timestamp'], stored_account=None,
                                       activity=[], running=[], observed_accounts=[]))
        row['activity'].append(event)
        row['modified'] = max(row['modified'], event['timestamp'])
        if event['event'] in ('auto_opened','manual_opened','turn_started') and event['account'] not in row['observed_accounts']:
            row['observed_accounts'].append(event['account'])
        if event['title']: row['title'] = event['title']
    runs = active_runs()
    unverified = []
    for run in runs:
        sid = run.get('session')
        if sid and sid not in rows and run.get('mode') == 'auto' and not run.get('tracking_version'):
            unverified.append(run)
            continue
        if not sid: continue
        row = rows.setdefault(sid, dict(id=sid,title=run.get('title') or '(untitled)',cwd=run.get('cwd') or '',
                                       modified=run.get('started') or 0,stored_account=None,
                                       activity=[],running=[],observed_accounts=[]))
        row['running'].append(run)
        if run['account'] not in row['observed_accounts']: row['observed_accounts'].append(run['account'])
        if run.get('title'): row['title'] = run['title']
    locals_ = [r for r in local_chats() if r['id'] not in rows]
    if include_local:
        for row in locals_:
            rows[row['id']] = dict(row, stored_account=None, activity=[], running=[], observed_accounts=[])
    return dict(conversations=sorted(rows.values(),key=lambda r:r['modified'],reverse=True),
                local_unknown_count=len(locals_), unverified_launches=unverified, unassigned_launches=[r for r in runs if not r.get('session')],
                unidentified_manual_history=[e for e in events if not e['session']],
                tracking_since=min((e['timestamp'] for e in events),default=None))

def show_overview(query='', account=None, include_local=False, history=False, limit=20, as_json=False):
    if limit < 1: raise Error('--limit must be at least 1.')
    overview = conversation_overview(include_local)
    reports = collect_status()
    words = query.casefold().split()
    matching = []
    for row in overview['conversations']:
        labels = set(row['observed_accounts']) | {row['stored_account']}
        labels.update(r['account'] for r in row['running'])
        labels.update(e['account'] for e in row['activity'])
        labels.update(e['previous_account'] for e in row['activity'])
        if account and account not in labels: continue
        if not all(w in (row['id']+' '+row['title']+' '+row['cwd']).casefold() for w in words): continue
        matching.append(row)
    overview.update(accounts=reports, total_matching=len(matching), conversations=matching[:limit])
    if as_json:
        print(json.dumps(overview, indent=2))
        return 0
    print('CONVERSATIONS AND ACCOUNTS\n')
    for report in reports:
        name = report['label']
        count = sum(r['stored_account'] == name for r in matching)
        print(f"{name} · {report['identity'][0]} · {count} matching saved chats · {len(report['runs'])} running")
        quota = usage_lines(report.get('usage'))
        print('  '+next((line for line in quota if '% left' in line),quota[0]))
    print(f'\nShowing {min(limit,len(matching))} of {len(matching)} matching chats')
    for row in matching[:limit]:
        print('\n'+clean_text(row['title'])[:110])
        print('  Project: '+clean_text(row['cwd']))
        if row['running']:
            print('  Running: '+'; '.join(r['account']+' · '+clean_text(r.get('phase') or 'CLI open') for r in row['running']))
        else: print('  Launcher state: '+('no verified running session' if overview['unverified_launches'] else 'not running'))
        print('  Stored under: '+(row['stored_account'] or ('local/Desktop' if row.get('source_home') else 'not found in saved history')))
        print('  Accounts observed in use: '+(', '.join(row['observed_accounts']) or 'not recorded yet'))
        print('  Updated: '+dt.datetime.fromtimestamp(row['modified']).strftime('%Y-%m-%d %H:%M %Z'))
        print('  ID: '+row['id'])
        if history:
            for event in row['activity']:
                timestamp = dt.datetime.fromtimestamp(event['timestamp']).strftime('%m-%d %H:%M:%S')
                route = (event['previous_account']+' → ' if event['previous_account'] else '')+event['account']
                print(f"    {timestamp} · {event['event'].replace('_',' ')} · {route}")
    for run in overview['unverified_launches']:
        if account and run['account'] != account: continue
        print(f"\nOlder launcher · {run['account']} · PID {run['pid']} · chat tracking unverified")
        print('  '+clean_text(run.get('title') or run.get('cwd')))
        print('  Exit and reopen with codex-accounts continue when convenient to restore tracking.')
    for run in overview['unassigned_launches']:
        if account and run['account'] != account: continue
        print(f"\nOpen CLI without a known chat ID: {run['account']} · {clean_text(run.get('cwd'))} · PID {run['pid']}")
    print(f"\n{overview['local_unknown_count']} local/Desktop chats have no launcher account history. Use --include-local to list them.")
    print('Stored location does not prove which account ran older turns. Activity tracking starts with v0.7.0; restart older launcher sessions to enable it.')
    print('Desktop activity and per-chat quota consumption are not tracked. Account emails above are the current connected identities.')
    return 0

def render_status(reports):
    print('CODEX ACCOUNTS · ' + dt.datetime.now().astimezone().strftime('%Y-%m-%d %H:%M:%S %Z'))
    if not reports:
        print('No accounts. Connect one with: codex-accounts add codex1')
    for report in reports:
        email, plan, identity_status = report['identity']
        print(f'\n{report["label"]} · {clean_text(email)} · {clean_text(plan)}')
        print(f'  Identity: {clean_text(identity_status)} · {len(report["runs"])} launcher session(s) open')
        cooldown = report['routing'].get('retry_after', 0)
        if cooldown > time.time():
            print('  Routing cooldown: retry eligible in ' + duration(cooldown - time.time()))
        if report.get('usage_error'):
            print('  Limits unavailable: ' + clean_text(report['usage_error']))
        else:
            checked = dt.datetime.fromtimestamp(report['checked_at']).astimezone().strftime('%H:%M:%S %Z')
            print('  Limits checked ' + checked)
            for line in usage_lines(report.get('usage')): print('  ' + line)
        for run in report['runs']:
            sid = run.get('session') or 'starting / ID not tracked'
            phase = clean_text(run.get('phase') or 'CLI open; turn state unknown')
            mode = clean_text(run.get('mode') or 'legacy launcher')
            print(f'  > {phase} · {mode} · PID {run["pid"]}')
            print('    Project: ' + clean_text(run.get('cwd')))
            print('    Conversation: ' + clean_text(sid))
            if run.get('title'): print('    Title: ' + clean_text(run['title'])[:120])
            if run.get('model'): print('    Model: ' + clean_text(run['model']))
            if run.get('started'):
                print('    Open for ' + duration(time.time() - run['started']))
    print('\nLocations cover this launcher on this computer, not desktop or ordinary codex sessions.')
    print('Missing limits mean unknown, not zero usage. Identity is cached; limits are queried live.')

def show_status(account=None, watch=False, interval=30, as_json=False):
    if watch and (as_json or not sys.stdout.isatty()):
        raise Error('--watch requires an interactive terminal and cannot be combined with --json.')
    if interval < 10:
        raise Error('Refresh interval must be at least 10 seconds.')
    try:
        while True:
            reports = collect_status(account)
            if watch: print('\033[2J\033[H', end='')
            if as_json: print(json.dumps(reports, indent=2))
            else: render_status(reports)
            if not watch: return 0
            print(f'\nRefresh every {interval}s · Ctrl-C to close')
            time.sleep(interval)
    except KeyboardInterrupt:
        if watch:
            print('\nStatus view closed.')
            return 0
        raise


def list_accounts():
    runs = active_runs()
    names = accounts()
    if not names:
        print('No accounts. Connect one with: codex-accounts add personal')
        return
    from concurrent.futures import ThreadPoolExecutor
    def identify(name):
        if not (require_account(name) / 'auth.json').is_file():
            return ('—', '—', 'needs login')
        try:
            return account_identity(name)
        except (Error, OSError, ValueError):
            return ('—', '—', 'identity unavailable')
    with ThreadPoolExecutor(max_workers=min(4, len(names))) as pool:
        identities = dict(zip(names, pool.map(identify, names)))
    email_width = max(5, *(len(identity[0]) for identity in identities.values()))
    plan_width = max(4, *(len(identity[1]) for identity in identities.values()))
    print(f"{'LABEL':<20} {'EMAIL':<{email_width}}  {'PLAN':<{plan_width}}  {'STATUS':<22} RUNNING")
    for name in names:
        count = sum(r['account'] == name for r in runs)
        routing = read_json(ROOT / 'routing.json', {}).get(name, {})
        remaining = max(0, int(routing.get('retry_after', 0) - time.time()))
        cooldown = f' · retry eligible in {remaining // 60}m {remaining % 60}s' if remaining else ''
        email, plan, status = identities[name]
        print(f"{name:<20} {email:<{email_width}}  {plan:<{plan_width}}  {status:<22} {count}{cooldown}")
    print('Email and plan are from cached Codex identity; quota and token validity are not checked.')
    print('Live limits and session locations: codex-accounts status --watch')

# Updates replace only this installed executable. Account data lives elsewhere.
import ast
import urllib.request
import urllib.error
import urllib.parse

RELEASE_REPO = 'JoRo-Code/codexx'
RELEASE_API = 'https://api.github.com/repos/' + RELEASE_REPO + '/releases?per_page=100'
UPDATE_INTERVAL = 3600

def executable_path():
    path = Path(__file__).resolve()
    marker = read_json(install_marker(path), {})
    if marker.get('bundle_root'):
        return Path(marker['bundle_root']) / 'current/codex-accounts'
    return path

def bundle_updates():
    import importlib.util
    path = executable_path().resolve().with_name('codexx_updates.py')
    spec = importlib.util.spec_from_file_location('codexx_bundle_updates', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module

def install_marker(path):
    return path.with_name('.' + path.name + '.install.json')

def version_tuple(value):
    match = re.fullmatch(r'v?(\d+)\.(\d+)\.(\d+)', value or '')
    if not match: raise Error('Release version is not a supported semantic version.')
    return tuple(int(n) for n in match.groups())

def fetch_public(url, limit=2_000_000):
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme != 'https' or parsed.hostname not in ('api.github.com', 'github.com'):
        raise Error('Update URL is not an approved HTTPS endpoint.')
    request = urllib.request.Request(url, headers={'User-Agent': 'codex-accounts/' + VERSION,
                                                  'Accept': 'application/vnd.github+json' if parsed.hostname == 'api.github.com' else 'application/octet-stream'})
    try:
        with urllib.request.urlopen(request, timeout=8) as response:
            final = urllib.parse.urlparse(response.geturl())
            if final.scheme != 'https' or final.hostname not in ('api.github.com', 'github.com',
                    'release-assets.githubusercontent.com', 'objects.githubusercontent.com'):
                raise Error('Update download redirected to an unapproved endpoint.')
            data = response.read(limit + 1)
            if len(data) > limit: raise Error('Update response exceeds the size limit.')
            return data
    except (urllib.error.URLError, TimeoutError) as exc:
        raise Error('Cannot reach GitHub releases. Check your connection and retry.') from exc

def newest_release(include_prerelease=False):
    releases = json.loads(fetch_public(RELEASE_API))
    if not isinstance(releases, list): raise Error('Invalid release catalog.')
    candidates = []
    for release in releases:
        if release.get('draft') or (release.get('prerelease') and not include_prerelease): continue
        try: version = version_tuple(release.get('tag_name'))
        except Error: continue
        candidates.append((version, release))
    if not candidates: raise Error('No eligible release found. Use --prerelease to include preview releases.')
    return max(candidates, key=lambda entry: entry[0])[1]

def release_asset(release, name):
    matches = [a for a in release.get('assets', []) if a.get('name') == name and a.get('state') == 'uploaded']
    if len(matches) != 1: raise Error('Release is missing the verified standalone update assets.')
    asset = matches[0]
    expected = f'https://github.com/{RELEASE_REPO}/releases/download/{release["tag_name"]}/{name}'
    if asset.get('browser_download_url') != expected: raise Error('Unexpected update artifact URL.')
    return asset

def verified_release(release):
    asset = release_asset(release, 'codex-accounts')
    checksum_asset = release_asset(release, 'codex-accounts.sha256')
    checksum = fetch_public(checksum_asset['browser_download_url'], 4096).decode('ascii').strip()
    match = re.fullmatch(r'([a-fA-F0-9]{64})\s+\*?codex-accounts', checksum)
    if not match: raise Error('Invalid release checksum file.')
    payload = fetch_public(asset['browser_download_url'])
    actual = hashlib.sha256(payload).hexdigest()
    if actual != match[1].lower(): raise Error('Update checksum mismatch; installed CLI was not changed.')
    digest = asset.get('digest')
    if digest and digest != 'sha256:' + actual: raise Error('GitHub artifact digest mismatch.')
    try:
        tree = ast.parse(payload.decode('utf-8'))
        versions = [node.value.value for node in tree.body if isinstance(node, ast.Assign)
                    and any(isinstance(t, ast.Name) and t.id == 'VERSION' for t in node.targets)
                    and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str)]
    except (SyntaxError, UnicodeError) as exc:
        raise Error('Downloaded launcher is not valid Python.') from exc
    if versions != [release['tag_name'].lstrip('v')]:
        raise Error('Downloaded launcher version does not match its release.')
    if b'Local ChatGPT account selection for Codex CLI' not in payload:
        raise Error('Downloaded artifact is not the expected launcher.')
    return payload

def installed_version(path):
    try:
        tree = ast.parse(path.read_text())
        for node in tree.body:
            if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'VERSION' for t in node.targets):
                value = ast.literal_eval(node.value)
                version_tuple(value)
                return value
    except (OSError, SyntaxError, ValueError, TypeError):
        pass
    raise Error('Cannot determine the installed version; executable was not changed.')

def stage_executable(destination, payload):
    fd, temporary = tempfile.mkstemp(prefix='.' + destination.name + '-', dir=destination.parent)
    path = Path(temporary)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(payload); stream.flush(); os.fsync(stream.fileno())
        path.chmod(0o755)
        result = subprocess.run([sys.executable, str(path), '--version'], capture_output=True,
                                text=True, timeout=10)
        if result.returncode:
            raise Error('New launcher failed its startup check; installed CLI was not changed.')
        version_tuple(result.stdout.strip())
        return path, result.stdout.strip()
    except BaseException:
        path.unlink(missing_ok=True)
        raise

def write_binary(path, payload):
    fd, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(payload); stream.flush(); os.fsync(stream.fileno())
        os.chmod(temporary, 0o755)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary): os.unlink(temporary)

def update_settings():
    return read_json(ROOT / 'updates.json', {})

def record_update(**fields):
    settings = update_settings()
    settings.update(fields)
    atomic_json(ROOT / 'updates.json', settings)

def update_policy(policy=None):
    with lock('update'):
        if policy: record_update(policy=policy)
        selected = update_settings().get('policy', 'auto')
    print('Update policy: ' + selected)
    print('Automatic checks run at launch and in long-running automatic sessions, at most once an hour.')

def self_update(check=False, rollback=False, prerelease=False):
    destination = executable_path()
    if read_json(install_marker(destination), {}).get('bundle_root'):
        return bundle_updates().update(sys.modules.get(__name__) or types.SimpleNamespace(**globals()),
                                       check=check, rollback=rollback, prerelease=prerelease)
    if not check and any((parent / '.git').exists() for parent in destination.parents):
        raise Error('This is a source checkout. Run the installed codex-accounts update, or use git pull here.')
    backup = destination.with_name('.' + destination.name + '.previous')
    with lock('update'):
        if rollback:
            if not backup.exists(): raise Error('No previous installed version is available.')
            staged, target = stage_executable(destination, backup.read_bytes())
            try:
                write_binary(backup, destination.read_bytes())
                os.replace(staged, destination)
            finally: staged.unlink(missing_ok=True)
            record_update(policy='notify', installed_version=target, last_check=time.time(), last_error=None)
            print('Rolled back to ' + target + '. Update policy is now notify to prevent immediate reinstallation.')
            return True
        current = installed_version(destination)
        release = newest_release(prerelease)
        target = release['tag_name'].lstrip('v')
        record_update(last_check=time.time(), available_version=target, last_error=None)
        if version_tuple(target) <= version_tuple(current):
            print('Already up to date (' + current + ').')
            return False
        if check:
            print(f'Update available: {current} -> {target}. Run codex-accounts update' + (' --prerelease' if prerelease else '') + '.')
            return False
        payload = verified_release(release)
        staged, staged_version = stage_executable(destination, payload)
        try:
            if staged_version != target: raise Error('Startup version does not match the selected release.')
            write_binary(backup, destination.read_bytes())
            os.replace(staged, destination)
        finally: staged.unlink(missing_ok=True)
        atomic_json(install_marker(destination), {'repository': RELEASE_REPO, 'version': target})
        record_update(installed_version=target)
        print(f'Updated {current} -> {target}. Accounts and history are unchanged.')
        print('Compatible running routers/automatic terminals adopt the update between requests, without restarting backends.')
        return True

def maybe_auto_update():
    if os.environ.get('CODEX_ACCOUNTS_NO_UPDATE') == '1': return
    destination = executable_path()
    marker = read_json(install_marker(destination), {})
    if marker.get('repository') != RELEASE_REPO: return
    settings = update_settings()
    policy = settings.get('policy', 'auto')
    if policy == 'off' or time.time() - settings.get('last_check', 0) < UPDATE_INTERVAL: return
    try:
        # Avoid delaying unrelated commands with repeated checks during outages.
        with lock('update'):
            record_update(last_check=time.time())
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            changed = self_update(check=policy == 'notify')
        if changed or 'Update available:' in output.getvalue():
            print(output.getvalue(), end='', file=sys.stderr)
        if changed:
            os.execv(sys.executable, [sys.executable, str(destination), *sys.argv[1:]])
    except (Error, OSError, ValueError, subprocess.SubprocessError):
        # CLI work must remain available offline. Explicit update reports errors.
        return


