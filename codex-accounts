class SetupWindow:
    def __init__(self, account=None, port=None):
        import secrets
        self.token=secrets.token_urlsafe(32)
        self.account,self.port=account,port
        self.mutex=threading.Lock()
        self.job=dict(busy=False,message='',error=False)
        self.reports=[]
        self.activity_cache={}
        self.activity_at=0
        self.activity_mutex=threading.Lock()
        self.last_usage_refresh=0
        self.last_usage_attempt=0
        self.last_seen=time.monotonic()

    def snapshot(self):
        settings=read_json(ROOT/DESKTOP_FILE,{})
        ready=False
        if settings:
            # Only local readiness is claimed, never a Desktop client connection.
            sock=socket.socket(socket.AF_UNIX);sock.settimeout(.2)
            ssh=socket.socket();ssh.settimeout(.2)
            try:
                sock.connect(settings['socket']);ssh.connect(('127.0.0.1',settings['port']));ready=True
            except OSError:pass
            finally:sock.close();ssh.close()
        with self.mutex:
            reports={r['label']:r for r in self.reports};job=dict(self.job)
        rows=[]
        for name in accounts():
            r=reports.get(name,{})
            connected=(account_home(name)/'auth.json').is_file()
            identity=r.get('identity',('','', ''))
            detail=re.sub(r'\[[#-]+\] ', '', ' · '.join(line for line in usage_lines(r['usage']) if '% left' in line)) if r.get('usage') else ('Usage not checked' if connected else 'Sign-in not complete — add this label again to retry')
            if not detail:detail='Usage unavailable — refresh to check again'
            rows.append(dict(label=name,email=identity[0] if identity[0]!='—' else '',connected=connected,detail=detail))
        return dict(accounts=rows,ready=ready,alias=settings.get('alias','codex-auto'),job=job,usage_checked_at=self.last_usage_refresh)

    def activity(self):
        with self.activity_mutex:
            if not self.activity_cache or time.monotonic()-self.activity_at>10:
                self.activity_cache=dashboard_activity();self.activity_at=time.monotonic()
            return self.activity_cache

    def set_reports(self,reports):
        save_usage_observations(reports)
        with self.mutex:
            self.reports=reports;self.last_usage_refresh=time.time()
        self.activity_at=0

    def start(self, action, label=''):
        if action not in ('connect','add','refresh'):raise Error('Unknown setup action')
        if not isinstance(label,str) or (label and not NAME.fullmatch(label)):raise Error('Use letters, numbers, hyphens or underscores for the account label.')
        with self.mutex:
            if self.job['busy']:raise Error('An operation is already running.')
            if action=='refresh':self.last_usage_attempt=time.time()
            self.job=dict(busy=True,error=False,message={'connect':'Configuring and checking your local connection…','add':'Complete sign-in in the browser. This may take a few minutes.','refresh':'Checking account usage…'}[action])
        threading.Thread(target=self.work,args=(action,label),daemon=True).start()

    def work(self, action, label):
        message='';failed=False
        try:
            with lock('setup-window-job'):
                if action=='refresh':
                    reports=collect_status()
                    self.set_reports(reports)
                    message='Usage updated.'
                else:
                    args=[sys.executable,str(executable_path())]
                    if action=='connect':
                        args+=['setup','--terminal']
                        if self.account:args+=['--account',self.account]
                        if self.port is not None:args+=['--port',str(self.port)]
                    else:
                        if not label:
                            index=1
                            while 'account-'+str(index) in accounts():index+=1
                            label='account-'+str(index)
                        if (account_home(label)/'auth.json').exists():raise Error('That label is already connected. Choose another label for a new account.')
                        args+=['login' if label in accounts() else 'add',label]
                    env=dict(os.environ,CODEX_ACCOUNTS_HOME=str(ROOT),CODEX_ACCOUNTS_NO_UPDATE='1')
                    # No OAuth URLs or credentials are forwarded to the web page.
                    process=subprocess.Popen(args,stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,env=env,start_new_session=True)
                    try:code=process.wait(timeout=600 if action=='add' else 90)
                    except subprocess.TimeoutExpired:
                        os.killpg(process.pid,signal.SIGTERM);process.wait(timeout=10)
                        raise Error('This step timed out. You can retry it here.')
                    if code:raise Error('Sign-in did not finish. Try Add account again with the same label.' if action=='add' else 'Connection setup could not finish. Run codex-accounts setup --terminal for the detailed error. Running chats were not restarted.')
                    message='Account added. Connect when you’re ready.' if action=='add' else 'Local connection ready. Finish the one-time link in Codex Desktop.'
                    reports=collect_status()
                    self.set_reports(reports)
        except (Error,OSError,ValueError,sqlite3.Error,subprocess.SubprocessError) as exc:
            message=str(exc);failed=True
        finally:
            with self.mutex:self.job=dict(busy=False,error=failed,message=message)


def setup_http_server(window):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    import secrets
    class Handler(BaseHTTPRequestHandler):
        def setup(self):
            super().setup();self.connection.settimeout(5)
        def log_message(self,*args):pass
        def reply(self,status,payload,html=False):
            body=payload.encode() if html else json.dumps(payload).encode()
            self.send_response(status)
            self.send_header('Content-Type','text/html; charset=utf-8' if html else 'application/json')
            self.send_header('Content-Length',str(len(body)))
            self.send_header('Cache-Control','no-store')
            self.send_header('X-Content-Type-Options','nosniff')
            self.send_header('Referrer-Policy','no-referrer')
            self.send_header('Content-Security-Policy',"default-src 'none'; img-src data:; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'")
            self.end_headers();self.wfile.write(body)
        def allowed(self,auth=True):
            host='127.0.0.1:'+str(self.server.server_port)
            return (self.headers.get('Host')==host and
                    self.headers.get('Origin','http://'+host)=='http://'+host and
                    (not auth or secrets.compare_digest(self.headers.get('Authorization','').encode(),('Bearer '+window.token).encode())))
        def do_GET(self):
            if not self.allowed(auth=self.path!='/'):return self.reply(403,{})
            if self.path=='/':return self.reply(200,SETUP_HTML,True)
            if self.path=='/api/activity':
                window.last_seen=time.monotonic()
                try:return self.reply(200,window.activity())
                except (Error,OSError,ValueError,sqlite3.Error,subprocess.SubprocessError):return self.reply(503,{'error':'Activity could not be read. Retrying shortly.'})
            if self.path=='/api/state':
                window.last_seen=time.monotonic()
                return self.reply(200,window.snapshot())
            self.reply(404,{})
        def do_POST(self):
            if not self.allowed():return self.reply(403,{})
            if self.path!='/api/action':return self.reply(404,{})
            try:
                length=int(self.headers.get('Content-Length','0'))
                if not 0<length<=1024:raise ValueError()
                data=json.loads(self.rfile.read(length))
                if not isinstance(data,dict):raise ValueError()
                window.start(data.get('action'),data.get('label',''))
            except (ValueError,TypeError):return self.reply(400,{})
            except Error as exc:
                with window.mutex:
                    if not window.job['busy']:window.job=dict(busy=False,error=True,message=str(exc))
                return self.reply(200,window.snapshot())
            self.reply(200,window.snapshot())
    return ThreadingHTTPServer(('127.0.0.1',0),Handler)


def serve_setup_window(account=None,port=None):
    import webbrowser
    window=SetupWindow(account,port)
    server=setup_http_server(window);server.timeout=1
    url='http://127.0.0.1:'+str(server.server_port)+'/#'+window.token
    window.start('refresh')
    if not webbrowser.open(url):
        server.server_close();raise Error('Could not open a browser. Use setup --terminal instead.')
    try:
        while time.monotonic()-window.last_seen<1800 or window.job['busy']:
            server.handle_request()
            if not window.job['busy'] and time.time()-window.last_usage_attempt>=60:
                window.start('refresh')
    finally:server.server_close()
    return 0


def open_setup_window(account=None,port=None):
    if sys.platform!='darwin':raise Error('Desktop setup currently supports macOS only.')
    args=[sys.executable,str(executable_path()),'setup-window']
    if account:args+=['--account',account]
    if port is not None:args+=['--port',str(port)]
    # Detach so closing the terminal cannot interrupt login or the setup page.
    subprocess.Popen(args,stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,
                     start_new_session=True,env=dict(os.environ,CODEX_ACCOUNTS_HOME=str(ROOT)))
    print('Opening Codex Accounts in your browser. Choose Add account or Connect there.')
    print('If the window does not open: codex-accounts setup --terminal')
    return 0

