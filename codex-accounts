def save_usage_observations(reports):
    """Persist quota samples, never credentials or inferred per-chat billing."""
    with contextlib.closing(sqlite3.connect(ROOT/'usage.sqlite',timeout=5)) as db:
        db.execute('CREATE TABLE IF NOT EXISTS samples (timestamp REAL, account TEXT, detail TEXT, availability TEXT)')
        for r in reports:
            detail=re.sub(r'\[[#-]+\] ', '', ' · '.join(line for line in usage_lines(r.get('usage')) if '% left' in line)) or 'Limits unavailable'
            last=db.execute('SELECT timestamp,detail,availability FROM samples WHERE account=? ORDER BY timestamp DESC LIMIT 1',(r['label'],)).fetchone()
            stamp=r.get('checked_at') or time.time();state=quota_state(r)
            if not last or last[1:]!=(detail,state) or stamp-last[0]>=300:
                db.execute('INSERT INTO samples VALUES (?,?,?,?)',(stamp,r['label'],detail,state))
        db.execute('DELETE FROM samples WHERE timestamp < ?',(time.time()-30*86400,))
        db.commit()


def dashboard_activity():
    overview=conversation_overview()
    # PID existence alone can mistake a reused PID for a connected chat.
    process_list=subprocess.run(['ps','-axo','pid=,command='],capture_output=True,text=True,timeout=5)
    launcher_pids=set()
    if process_list.returncode==0:
        for line in process_list.stdout.splitlines():
            parts=line.strip().split(None,1)
            if len(parts)==2 and re.search(r'(?:^|/)codex-accounts (?:serve|auto|continue|run|resume)(?: |$)',parts[1]):
                launcher_pids.add(int(parts[0]))
    chats=[]
    for row in overview['conversations']:
        runs=[r for r in row['running'] if r.get('pid') in launcher_pids]
        chats.append(dict(id=row['id'],title=row['title'],project=row['cwd'],updated=row['modified'],
                          live=bool(runs),account=', '.join(sorted({r['account'] for r in runs})) or row['stored_account'] or ', '.join(row['observed_accounts']) or 'Unknown',
                          assignment='Current account' if runs else ('Stored under' if row['stored_account'] else 'Last observed account'),
                          state=', '.join(sorted({r.get('phase') or 'Connected' for r in runs})) or 'Not connected',
                          model=', '.join(sorted({r['model'] for r in runs if r.get('model')}))))
    events=[{k:e.get(k) for k in ('timestamp','session','account','event','title','previous_account')} for e in activity_records()[-200:]][::-1]
    samples=[];path=ROOT/'usage.sqlite'
