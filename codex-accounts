        with contextlib.closing(sqlite3.connect(path.as_uri()+'?mode=ro',uri=True)) as db:
            db.row_factory=sqlite3.Row
            samples=[dict(r) for r in db.execute('SELECT * FROM samples ORDER BY timestamp DESC LIMIT 100')]
    return dict(chats=chats,events=events,usage_history=samples,checked_at=time.time(),
