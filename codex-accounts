def main(argv=None):
    args = parser().parse_args(argv)
    os.umask(0o077)
    private_dir(ROOT)
    if args.action == 'setup': return (setup_desktop if args.terminal else open_setup_window)(args.account,args.port)
    if args.action == 'setup-window': return serve_setup_window(args.account,args.port)
    if args.action == 'desktop-shell': return desktop_shell()
    if args.action == 'desktop-proxy': return desktop_proxy(args.arguments)
    if args.action == 'desktop':
        if args.operation=='status': desktop_status(args.json)
        else: desktop_service(args.operation)
        return 0
    if args.action == 'serve':
        return serve_router(args.socket, args.account)
    if args.action == 'routing':
        if args.threshold is not None or args.off:
            atomic_json(ROOT/'routing-policy.json', {'threshold': args.threshold})
        threshold = routing_threshold()
        print('Pre-turn quota rotation: '+(str(threshold)+'% used; current account remains usable if no alternative qualifies.'
                                           if threshold is not None else 'off (quota-error failover only).'))
        return 0
    if args.action == 'permissions':
        permissions(args.mode)
        return 0
    if args.action == 'defaults':
        if args.clear and (args.model is not None or args.effort is not None):
            raise Error('--clear cannot be combined with --model or --effort.')
        defaults(args.model, args.effort, args.clear)
        return 0
    if args.action == 'shared':
        shared_capabilities(args.operation, args.source_home, args.json)
        return 0
    if args.action == 'update':
        if args.operation:
            if args.check or args.rollback or args.prerelease:
                raise Error('Update policy cannot be combined with update flags.')
            update_policy(args.policy)
        else:
            if args.policy: raise Error('Use update policy auto|notify|off.')
            self_update(args.check, args.rollback, args.prerelease)
        return 0
    maybe_auto_update()
    if args.action is None:
        return menu()
    if args.action in ('add', 'login'):
        login(args.account, args.device_auth, create=args.action == 'add')
    elif args.action == 'list':
        list_accounts()
    elif args.action == 'status':
        return show_status(args.account, args.watch, args.interval, args.json)
    elif args.action == 'auto':
        return auto_run(args.account, args.resume, args.cd, args.model, args.prompt)
    elif args.action == 'continue':
        return continue_chat(' '.join(args.query), args.account, args.source_home, args.list, args.json)
    elif args.action == 'overview':
        return show_overview(' '.join(args.query), args.account, args.include_local, args.history, args.limit, args.json)
    elif args.action == 'run':
        return run(choose_account(args.account), prompt=args.prompt, cwd=args.cd, model=args.model)
    elif args.action == 'sessions':
        rows = session_records(args.account)
        for row in rows:
            print(describe_session(row))
        if not rows:
            print('No saved conversations found in launcher accounts.')
    elif args.action == 'resume':
        row = choose_session(args.session, args.account)
        return run(row['account'], row, args.prompt, args.cd, args.model)
    elif args.action == 'switch':
        move(choose_session(args.session), args.to)
    return 0

# Automatic routing keeps the native Codex TUI connected to a local WebSocket
# bridge. The backend remains the official Codex app-server (stdio transport).
import base64
import hashlib
import select
import signal
import socket
import struct
from collections import deque

QUOTA_ERRORS = {'usageLimitExceeded', 'rateLimitExceeded'}

class WebSocket:
    """Minimal RFC 6455 server transport over a private Unix-domain socket."""
    def __init__(self, sock):
        self.sock = sock
        self.buffer = bytearray()
        self.fragments = bytearray()
        request = bytearray()
        while b'\r\n\r\n' not in request:
            data = sock.recv(4096)
            if not data:
                raise Error('Terminal closed during connection setup.')
            request.extend(data)
            if len(request) > 65536:
                raise Error('Oversized WebSocket handshake.')
        headers, _, remainder = request.partition(b'\r\n\r\n')
        self.buffer.extend(remainder)
        parsed = {}
        for line in headers.decode('ascii').split('\r\n')[1:]:
            key, _, value = line.partition(':')
            parsed[key.lower()] = value.strip()
        key = parsed.get('sec-websocket-key')
        if not key:
            raise Error('Missing WebSocket handshake key.')
        digest = base64.b64encode(hashlib.sha1((key + '258EAFA5-E914-47DA-95CA-C5AB0DC85B11').encode()).digest()).decode()
        sock.sendall(('HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\n'
                      'Connection: Upgrade\r\nSec-WebSocket-Accept: '+digest+'\r\n\r\n').encode())

    def send_frame(self, opcode, payload):
        length = len(payload)
        header = bytes([0x80 | opcode])
        if length < 126:
            header += bytes([length])
        elif length < 65536:
            header += b'\x7e' + struct.pack('!H', length)
        else:
            header += b'\x7f' + struct.pack('!Q', length)
        self.sock.sendall(header + payload)

    def send(self, message):
        self.send_frame(1, json.dumps(message).encode())

    def read(self):
        data = self.sock.recv(65536)
        if not data:
            raise EOFError
        self.buffer.extend(data)
        messages = []
        while len(self.buffer) >= 2:
            first, second = self.buffer[:2]
            size, offset = second & 127, 2
            if size == 126:
                if len(self.buffer) < 4: break
                size, offset = struct.unpack('!H', self.buffer[2:4])[0], 4
            elif size == 127:
                if len(self.buffer) < 10: break
                size, offset = struct.unpack('!Q', self.buffer[2:10])[0], 10
            if not second & 128 or first & 0x70 or size > 64 * 1024 * 1024:
                raise Error('Invalid or oversized WebSocket frame.')
            if len(self.buffer) < offset + 4 + size: break
            mask = self.buffer[offset:offset+4]
            payload = bytes(v ^ mask[i % 4] for i,v in enumerate(self.buffer[offset+4:offset+4+size]))
            del self.buffer[:offset+4+size]
            opcode = first & 15
            if opcode == 8:
                raise EOFError
            if opcode == 9:
                self.send_frame(10, payload)
                continue
            if opcode == 10:
                continue
            if opcode not in (0, 1):
                raise Error('Unsupported WebSocket message type.')
            self.fragments.extend(payload)
            if len(self.fragments) > 64 * 1024 * 1024:
                raise Error('Oversized WebSocket message.')
            if first & 0x80:
                messages.append(json.loads(self.fragments))
                self.fragments.clear()
        return messages

@contextlib.contextmanager
def routing_state():
    private_dir(ROOT / 'locks')
    with (ROOT / 'locks/routing.lock').open('a') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        state = read_json(ROOT / 'routing.json', {})
        yield state
        atomic_json(ROOT / 'routing.json', state)

def eligible_accounts(exclude=()):
    with routing_state() as state:
        names = [name for name in accounts() if name not in exclude
                 and (require_account(name) / 'auth.json').is_file()
                 and state.get(name, {}).get('retry_after', 0) <= time.time()]
        running = active_runs()
        return sorted(names, key=lambda n: (sum(r['account']==n for r in running),
                                             state.get(n, {}).get('last_selected', 0), n))

def mark_selected(name):
    with routing_state() as state:
        state.setdefault(name, {})['last_selected'] = time.time()

def routing_threshold():
    threshold = (read_json(ROOT/'routing-policy.json', {}) or {}).get('threshold')
    if threshold is not None and (type(threshold) is not int or not 1 <= threshold <= 100):
        raise Error('Invalid quota rotation threshold; use codex-accounts routing --threshold 95.')
    return threshold

def ordinary_quota_ready(usage, threshold):
    """Require known ordinary quota; available credits never make a window eligible."""
    if not isinstance(usage, dict): return False
    if usage.get('ordinaryUsageAllowed') is False: return False
    limits = usage.get('rateLimits') or (usage.get('rateLimitsByLimitId') or {}).get('codex') or {}
    windows = [limits.get(key) for key in ('primary', 'secondary') if limits.get(key) is not None]
    if not windows: return False
    return all(isinstance(window, dict) and type(window.get('usedPercent')) in (int, float)
               and 0 <= window['usedPercent'] < threshold for window in windows)

def quota_ready_accounts(exclude=()):
    choices = eligible_accounts(exclude)
    threshold = routing_threshold()
    if threshold is None: return choices
    ready = []
    for name in choices:
        try:
            report = account_snapshot(name, include_usage=True)
            if ordinary_quota_ready(report.get('usage'), threshold): ready.append(name)
        except (Error, OSError, ValueError):
            continue
    return ready

def mark_quota_failure(name, error, snapshot=None):
    windows = [(snapshot or {}).get(k) or {} for k in ('primary','secondary')]
    resets = [w.get('resetsAt') for w in windows if w.get('usedPercent', 0) >= 100
              and isinstance(w.get('resetsAt'), (int,float)) and w['resetsAt'] > time.time()]
    # A timer schedules another attempt; it does not claim quota has recovered.
    delay = 60 if error == 'rateLimitExceeded' else 300
    with routing_state() as state:
        row = state.setdefault(name, {})
        row['retry_after'] = max(resets) if resets else time.time() + delay
        row['reason'] = error

class Backend:
    def __init__(self, name):
        self.name = name
        self.buffer = bytearray()
        self.messages = deque()
        self.logs = tempfile.TemporaryFile()
        self.process = subprocess.Popen(command('app-server'), env=environment(name),
                                        stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                        stderr=self.logs, start_new_session=True)
    def send(self, message):
        self.process.stdin.write((json.dumps(message)+'\n').encode())
        self.process.stdin.flush()
    def read(self):
        data = os.read(self.process.stdout.fileno(), 65536)
        if not data:
            raise Error('Codex backend exited. Your saved conversation can be resumed.')
        self.buffer.extend(data)
        while b'\n' in self.buffer:
            line, _, rest = self.buffer.partition(b'\n')
            self.buffer[:] = rest
            if line.strip():
                self.messages.append(json.loads(line))
    def close(self):
        # This backend owns a dedicated process group. Stop its tools as well
        # as the server before handing history to the next account.
        try:
            os.killpg(self.process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            self.process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
        try:
            os.killpg(self.process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        self.process.wait()
        self.logs.close()

class AutoBridge:
    def __init__(self, name, ws, marker, factory=Backend, cwd=None):
        self.name, self.ws, self.marker, self.factory = name, ws, marker, factory
        self.started = time.time()
        self.cwd = cwd or os.getcwd()
        self.phase = 'starting'
        self.title = None
        self.approvals = set()
        self.backend = None
        self.account_lock = None
        self.session_lock = None
        self.sid = None
        self.initialize = None
        self.pending = {}
        self.pending_thread_options = {}
        self.counter = 0
        self.tried = set()
        self.snapshot = None
        self.quota_errors = {}
        self.thread_options = {}
        self.continuation_options = {}
        self.recorded_connections = set()
        self.open_backend(name)
    def open_backend(self, name):
        self.account_lock = lock('account-' + name, shared=True)
        self.account_lock.__enter__()
        try:
            self.backend = self.factory(name)
        except BaseException:
            self.account_lock.__exit__(None,None,None)
            self.account_lock = None
            raise
        self.name = name
        self.snapshot = None
        mark_selected(name)
        self.update_marker()
    def close_backend(self):
        if self.backend:
            self.backend.close()
            self.backend = None
        if self.account_lock:
            self.account_lock.__exit__(None,None,None)
            self.account_lock = None
    def update_marker(self):
        atomic_json(self.marker, dict(pid=os.getpid(),account=self.name,session=self.sid,
                                     tracking_version=VERSION,
                                     live_runtime_abi=LIVE_RUNTIME_ABI,
                                     launcher_generation=getattr(self, '_live_generation', None),
                                     cwd=self.thread_options.get('cwd') or self.cwd, started=self.started,
                                     updated=time.time(),mode='auto',phase=self.phase,
                                     model=self.thread_options.get('model'),title=self.title))
    def set_thread(self, thread):
        if thread.get('ephemeral'): return
        sid = thread['id']
        if sid != self.sid:
            if self.session_lock:
                self.session_lock.__exit__(None,None,None)
                self.session_lock = None
            new_lock = lock('session-' + sid)
            new_lock.__enter__()
            self.session_lock = new_lock
            self.sid = sid
        self.title = thread.get('name') or thread.get('preview') or self.title
        self.phase = 'working' if (thread.get('status') or {}).get('type') == 'active' else 'idle'
        for key in ('model','cwd'):
            if thread.get(key): self.thread_options[key] = thread[key]
        connection = (self.sid, self.name)
        if connection not in self.recorded_connections:
            record_activity(self.sid, self.name, 'auto_opened', cwd=self.thread_options.get('cwd') or self.cwd,
                            title=self.title)
            self.recorded_connections.add(connection)
        self.update_marker()
    def from_client(self, message):
        method, params = message.get('method'), message.get('params', {})
        if not method and json.dumps(message.get('id')) in self.approvals:
            self.approvals.discard(json.dumps(message.get('id')))
            self.phase = 'working'
            self.update_marker()
        if method == 'initialize':
            self.initialize = params
        if method in ('thread/start','thread/resume','thread/fork') and 'id' in message:
            # Only adopt these options after a persistent-thread response.
            self.pending_thread_options[json.dumps(message['id'])] = {
                k:v for k,v in params.items() if k in
                ('model','cwd','approvalPolicy','approvalsReviewer','sandbox','serviceTier','personality','config')}
        if method == 'turn/start' and self.sid and params.get('threadId') == self.sid:
            try:
                self.prepare_turn()
            except (Error, OSError, ValueError, sqlite3.Error) as exc:
                self.ws.send(dict(id=message.get('id'), error=dict(code=-32000, message=str(exc))))
                return
            self.phase = 'starting turn'
            if not self.title:
                self.title = next((x.get('text') for x in params.get('input', []) if x.get('type') == 'text'), None)
            for key in ('cwd', 'model'):
                if params.get(key): self.thread_options[key] = params[key]
            self.update_marker()
            self.tried = {self.name}
            self.continuation_options = {k:v for k,v in params.items() if k in
                ('model','cwd','approvalPolicy','approvalsReviewer','sandboxPolicy','effort','summary','serviceTier','personality')}
        if 'id' in message and method:
            self.pending[json.dumps(message['id'])] = method
        self.backend.send(message)

    def prepare_turn(self):
        threshold = routing_threshold()
        if threshold is None: return
        # Never stop tools or copy history while the previous turn is still active.
        if self.phase in ('working', 'starting turn', 'waiting for input'):
            return
        # Native thread/start may not persist history until its first turn.
        # Migration needs that history; blocking the turn here would prevent
        # it from ever being written. Let the current backend accept it first.
        if not any(row['id'] == self.sid for row in session_records(self.name)):
            return
        try:
            usage = self.rpc('account/rateLimits/read', {})
        except (Error, OSError, ValueError):
            return  # Quota rotation is a preference, not a ban on credit use.
        limits = usage.get('rateLimits') or (usage.get('rateLimitsByLimitId') or {}).get('codex') or {}
        windows = [limits.get(key) or {} for key in ('primary', 'secondary')]
        if usage.get('ordinaryUsageAllowed') is not False and not any(
                type(w.get('usedPercent')) in (int, float) and w['usedPercent'] >= threshold for w in windows):
            return  # Missing quota data alone is not a reason to migrate.
        if ordinary_quota_ready(usage, threshold): return
        choices = quota_ready_accounts({self.name})
        if not choices:
            return
        record_activity(self.sid, self.name, 'quota_rotation', cwd=self.thread_options.get('cwd') or self.cwd,
                        title=self.title)
        self.reconnect_account(choices[0])

    def reconnect_account(self, target):
        row = choose_session(self.sid)
        self.phase = 'switching account'
        self.update_marker()
        self.close_backend()
        self.marker.unlink(missing_ok=True)
        for ident in list(self.pending):
            self.ws.send(dict(id=json.loads(ident), error=dict(code=-32000,message='Account is reconnecting; retry this request.')))
        self.pending.clear()
        self.pending_thread_options.clear()
        move(row, target, already_locked=True, quiet=True)
        self.open_backend(target)
        self.rpc('initialize', self.initialize)
        self.backend.send(dict(method='initialized'))
        resume_options = dict(self.thread_options, threadId=self.sid)
        if row['history_mode'] == 'paginated': resume_options['excludeTurns'] = True
        resumed = self.rpc('thread/resume', resume_options)
        self.set_thread(resumed['thread'])
        account = self.rpc('account/read', {'refreshToken':False}).get('account') or {}
        self.ws.send(dict(method='account/updated',params=dict(authMode='chatgpt',planType=account.get('planType'))))
    def inspect(self, message):
        method, params = message.get('method'), message.get('params', {})
        if params.get('threadId') == self.sid and self.sid:
            if method == 'turn/started':
                self.phase = 'working'
                turn_id = (params.get('turn') or {}).get('id')
                record_activity(self.sid, self.name, 'turn_started', cwd=self.thread_options.get('cwd') or self.cwd,
                                title=self.title, key=(self.sid+':'+self.name+':turn:'+turn_id) if turn_id else None)
                self.update_marker()
            elif method == 'turn/completed':
                status = (params.get('turn') or {}).get('status')
                self.phase = 'idle' if status == 'completed' else (status or 'unknown')
                self.update_marker()
            elif 'id' in message and method and ('requestApproval' in method or method == 'item/tool/requestUserInput'):
                self.approvals.add(json.dumps(message['id']))
                self.phase = 'waiting for input'
                self.update_marker()
        if method == 'error' and params.get('threadId') == self.sid and not params.get('willRetry', True):
            code = (params.get('error') or {}).get('codexErrorInfo')
            if isinstance(code, str) and code in QUOTA_ERRORS:
                self.quota_errors[params.get('turnId')] = code
        if method == 'account/rateLimits/updated':
            incoming = params.get('rateLimits') or {}
            if not self.snapshot or incoming.get('limitId') == self.snapshot.get('limitId'):
                self.snapshot = {**(self.snapshot or {}), **{k:v for k,v in incoming.items() if v is not None}}
        if 'id' in message and not method:
            original = self.pending.pop(json.dumps(message['id']), None)
            options = self.pending_thread_options.pop(json.dumps(message['id']), {})
            if original in ('thread/start','thread/resume','thread/fork') and 'result' in message:
                thread = message['result']['thread']
                if not thread.get('ephemeral'):
                    self.thread_options = options
                    self.set_thread(thread)
    def from_backend(self, message):
        self.inspect(message)
        self.ws.send(message)
        if message.get('method') != 'turn/completed': return
        params = message.get('params', {})
        if params.get('threadId') != self.sid: return
        turn = params.get('turn') or {}
        info = (turn.get('error') or {}).get('codexErrorInfo') or self.quota_errors.get(turn.get('id'))
        self.quota_errors.pop(turn.get('id'), None)
        if turn.get('status') == 'failed' and isinstance(info, str) and info in QUOTA_ERRORS:
            self.failover(info)
    def rpc(self, method, params, timeout=30):
        self.counter += 1
        ident = 'codex-accounts-internal-' + str(self.counter)
        self.backend.send(dict(id=ident,method=method,params=params))
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            while self.backend.messages:
                message = self.backend.messages.popleft()
                if message.get('id') == ident:
                    if 'error' in message: raise Error(str(message['error'].get('message','Codex request failed')))
                    return message.get('result', {})
                self.inspect(message)
                self.ws.send(message)
            if select.select([self.backend.process.stdout], [], [], .25)[0]:
                self.backend.read()
        raise Error('Codex reconnect timed out; saved conversation was retained.')
    def failover(self, info):
        record_activity(self.sid, self.name, info, cwd=self.thread_options.get('cwd') or self.cwd, title=self.title)
        mark_quota_failure(self.name, info, self.snapshot)
        self.tried.add(self.name)
        choices = quota_ready_accounts(self.tried)
        if not choices: choices = eligible_accounts(self.tried)
        if not choices or not self.sid:
            return  # Original quota failure is already visible in the native TUI.
        target = choices[0]
        # Backend has reported the failed turn completed. Stop it before copying
        # history, so no tools or history writers survive on the source account.
        self.reconnect_account(target)
        self.tried.add(target)
        continuation = ('Continue the unfinished request from the preceding turn. The account reached its usage limit '
                        'and the launcher reconnected this conversation using another account. Inspect the saved history '
                        'and current state, preserve completed work, and do not repeat completed side effects.')
        self.rpc('turn/start', dict(self.continuation_options, threadId=self.sid,
                 input=[{'type':'text','text':continuation,'text_elements':[]}]))
    def close(self):
        self.close_backend()
        if self.session_lock:
            self.session_lock.__exit__(None,None,None)
        self.marker.unlink(missing_ok=True)

def auto_exit_message(sid):
    print('\nLauncher stopped its backend; work is not continuing in the background.')
    print('The temporary --remote socket above is closed. Do not use that reconnect command.')
    if sid and any(row['id'] == sid for row in session_records()):
        print('Resume this saved chat with:')
        print('  codex-accounts auto --resume ' + sid)
    else:
        print('No saved chat was found for this launch. Start again with codex-accounts auto.')

def auto_run(account=None, session=None, cwd=None, model=None, prompt=None):
    if not sys.stdin.isatty():
        raise Error('Automatic mode uses the native interactive Codex terminal; run it in a terminal.')
    row = choose_session(session) if session else None
    requested_account = account
    if row:
        account = row['account']
        if requested_account and requested_account != account:
            move(row, requested_account)
            account = requested_account
            row = choose_session(session)
    choices = eligible_accounts()
    if not account:
        if not choices:
            raise Error('No connected accounts are ready. Add an account or wait for its cooldown to expire.')
        account = choices[0]
    require_account(account)
    if not (require_account(account) / 'auth.json').is_file():
        raise Error('Connect this account first: codex-accounts login ' + account)
    if row and not requested_account and account not in choices and choices:
        move(row, choices[0])
        account = choices[0]
        row = choose_session(session)
    working = str(Path(cwd or (row and row['cwd']) or os.getcwd()).expanduser().resolve())
    if not Path(working).is_dir(): raise Error('Project directory does not exist: ' + working)
    private_dir(ROOT / 'runs')
    marker = ROOT / 'runs' / (str(uuid.uuid4()) + '.json')
    # Keep Unix socket paths short enough for macOS's 104-byte sun_path.
    with tempfile.TemporaryDirectory(prefix='codex-accounts-',dir='/tmp') as temp:
        address = str(Path(temp) / 'tui.sock')
        listener = socket.socket(socket.AF_UNIX)
        listener.bind(address); listener.listen(1); listener.settimeout(.25)
        tui, bridge, connected = None, None, None
        previous_sigint = signal.getsignal(signal.SIGINT)
        try:
            args = ['resume',row['id']] if row else []
            args += ['--remote','unix://'+address,'--cd',working]
            if model: args += ['--model',model]
            # Remote resume uses the task's saved permissions. The CLI rejects
            # permission overrides here; shared defaults still reach the backend.
            cmd = command(*args, include_permissions=not bool(row))
            if prompt: cmd += ['--',prompt]
            print(f'Automatic account routing · starting with {account}', flush=True)
            tui = subprocess.Popen(cmd, env=environment(account), cwd=working)
            # Ctrl-C belongs to the foreground native TUI; keep its bridge alive.
            signal.signal(signal.SIGINT, lambda *_: None)
            deadline = time.monotonic()+30
            while tui.poll() is None and time.monotonic()<deadline:
                try:
                    connected, _ = listener.accept(); break
                except socket.timeout: pass
            if connected is None:
                if tui.poll() is not None: return tui.returncode
                raise Error('Codex terminal did not connect within 30 seconds.')
            connected.settimeout(5)
            ws = WebSocket(connected)
            runtime = LiveRuntime()
            bridge = AutoBridge(account, ws, marker, cwd=working)
            while tui.poll() is None:
                while bridge.backend.messages:
                    bridge.from_backend(bridge.backend.messages.popleft())
                runtime.refresh()
                adopt_bridge_runtime(bridge, runtime)
                ready,_,_ = select.select([connected,bridge.backend.process.stdout],[],[],.25)
                if connected in ready:
                    for message in ws.read(): bridge.from_client(message)
                if bridge.backend.process.stdout in ready: bridge.backend.read()
            return tui.returncode
        except EOFError:
            return tui.wait(timeout=5) if tui else 0
        finally:
            if bridge: bridge.close()
            if 'runtime' in locals(): runtime.close()
            if tui and tui.poll() is None:
                tui.terminate()
                try: tui.wait(timeout=5)
                except subprocess.TimeoutExpired: tui.kill(); tui.wait()
            if connected: connected.close()
            listener.close()
            marker.unlink(missing_ok=True)
            signal.signal(signal.SIGINT, previous_sigint)
            if bridge:
                auto_exit_message(bridge.sid or (row and row['id']))


# The persistent router isolates each root conversation in its own backend.
# A lane is an actor: only its worker touches AutoBridge/backend state.
import queue
import threading
from concurrent.futures import Future
import types

class LiveRuntime:
    """Load compatible generations while sockets, actor state and backends survive."""
    def __init__(self, source=None, namespace=None):
        self.source = Path(source or executable_path())
        self.module = types.SimpleNamespace(**(namespace or dict(globals())))
        self.mutex = threading.RLock()
        self.fingerprint = None
        self.checked = 0
        self.error = None
        self.updater = None
        self.updater_started = 0
        try:
            self.fingerprint = hashlib.sha256(self.source.read_bytes()).hexdigest()
            self.file_state = self.stamp()
        except OSError: self.file_state = None

    def stamp(self):
        info = self.source.stat()
        return (info.st_ino, info.st_size, info.st_mtime_ns)

    def refresh(self, force=False):
        with self.mutex:
            requested = (read_json(ROOT / 'session-updates.json', {}) or {}).get('requested_at')
            if requested and requested != getattr(self, '_session_update_request', None):
                self._session_update_request = requested
                force = True
            now = time.monotonic()
            if not force and now-self.checked < 1: return self.module
            self.checked = now
            try: self.check_update()
            except (OSError, subprocess.SubprocessError): pass
            try:
                stamp = self.stamp()
                if stamp == self.file_state: return self.module
                payload = self.source.read_bytes()
                digest = hashlib.sha256(payload).hexdigest()
                self.file_state = stamp
                if digest == self.fingerprint: return self.module
                candidate = types.ModuleType('codex_accounts_live_'+digest)
                candidate.__file__ = str(self.source)
                exec(compile(payload, str(self.source), 'exec'), candidate.__dict__)
                if getattr(candidate, 'LIVE_RUNTIME_ABI', None) != LIVE_RUNTIME_ABI:
                    raise Error('Installed update requires a newer live-state ABI; current chats continue on their loaded code.')
                for name in ('AutoBridge','MultiRouter','Backend','RouterLane','router_bridge_class'):
                    if not callable(getattr(candidate, name, None)):
                        raise Error('Installed update is missing live runtime exports: '+name)
                for name in ('AutoBridge','MultiRouter','Backend','RouterLane'):
                    cls = getattr(candidate, name)
                    if not isinstance(cls, type) or '__slots__' in cls.__dict__:
                        raise Error('Installed update has incompatible live object layout: '+name)
                # Keep the process's explicit home/binary and one exception identity.
                candidate.ROOT, candidate.BINARY, candidate.Error = ROOT, BINARY, Error
                self.module = candidate
                self.fingerprint = digest
                self.error = None
                print('Live launcher update ready ('+candidate.VERSION+'); chats adopt it when idle.',
                      file=sys.stderr, flush=True)
            except Exception as exc:
                message = str(exc)
                if message != self.error:
                    print('Live launcher update deferred: '+message, file=sys.stderr, flush=True)
                self.error = message
            return self.module

    def check_update(self):
        # Network checks run in a separate process; a long model turn never waits.
        if self.updater:
            if self.updater.poll() is not None: self.updater = None
            elif time.monotonic()-self.updater_started > 45:
                self.updater.terminate()
            return
        if os.environ.get('CODEX_ACCOUNTS_NO_UPDATE') == '1': return
        try:
            if read_json(install_marker(self.source), {}).get('repository') != RELEASE_REPO: return
            with lock('update'):
                settings = update_settings()
                if settings.get('policy','auto') == 'off' or time.time()-settings.get('last_check',0) < UPDATE_INTERVAL: return
                record_update(last_check=time.time())
            args = [sys.executable, str(self.source), 'update']
            if settings.get('policy') == 'notify': args.append('--check')
            self.updater = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                           stderr=subprocess.DEVNULL, start_new_session=True,
                                           env=dict(os.environ, CODEX_ACCOUNTS_HOME=str(ROOT), CODEX_ACCOUNTS_NO_UPDATE='1'))
            self.updater_started = time.monotonic()
        except (Error, OSError, ValueError): pass

    def close(self):
        if self.updater and self.updater.poll() is None:
            self.updater.terminate()
            try: self.updater.wait(timeout=5)
            except subprocess.TimeoutExpired: self.updater.kill(); self.updater.wait()

def adopt_bridge_runtime(bridge, runtime, lane=None):
    # Adoption occurs only in the owning actor, outside an active turn/RPC/approval.
    if bridge.phase in ('working','starting turn','waiting for input','switching account'):
        return False
    if bridge.pending or bridge.approvals or bridge.backend.messages: return False
    with runtime.mutex:
        module, fingerprint = runtime.module, runtime.fingerprint
    if getattr(bridge, '_live_generation', None) == fingerprint: return False
    bridge.__class__ = module.router_bridge_class(lane) if lane is not None else module.AutoBridge
    if bridge.backend.__class__.__dict__.get('_live_native_backend', False):
        bridge.backend.__class__ = module.Backend
    if bridge.factory is Backend or bridge.factory.__dict__.get('_live_native_backend', False):
        bridge.factory = module.Backend
    bridge._live_generation = fingerprint
    if lane is None or not lane.control: bridge.update_marker()
    return True

def router_bridge_class(lane):
    class Bridge(AutoBridge):
        def update_marker(self):
            if self.sid and not lane.control: super().update_marker()
        def open_backend(self, name):
            lane.generation += 1
            super().open_backend(name)
        def set_thread(self, thread):
            if lane.control or thread.get('ephemeral'): return
            if self.sid and thread['id'] != self.sid: return
            super().set_thread(thread)
        def failover(self, info):
            try: super().failover(info)
            except (Error, OSError, ValueError, sqlite3.Error) as exc:
                self.phase = 'switch failed'
                self.update_marker()
                lane.router.notice(self.sid, 'Account switch failed: '+str(exc))
            if self.phase == 'failed':
                self.phase = 'waiting for quota'
                self.update_marker()
                lane.router.notice(self.sid, 'No other account is ready. Resume after an account reset or add another account.')
    return Bridge

Backend._live_native_backend = True

class RouterLane:
    def __init__(self, router, account, initialize, control=False):
        self.router, self.control = router, control
        self.inbox = queue.Queue(maxsize=1024)
        self.ready = Future()
        self.stopped = threading.Event()
        self.generation = 0
        self.bridge = None
        self.thread = threading.Thread(target=self.run, args=(account, initialize), daemon=True)
        self.thread.start()

    def send(self, message):
        self.router.output(self, message)

    def submit(self, message):
        if self.stopped.is_set(): raise Error('Conversation backend stopped; reconnect to resume saved history.')
        try: self.inbox.put_nowait(('send', message, None))
        except queue.Full: raise Error('Conversation request queue is full; retry shortly.')

    def call(self, method, params):
        result = Future()
        if self.stopped.is_set(): raise Error('Backend stopped.')
        self.inbox.put(('rpc', (method, params), result), timeout=5)
        return result.result(timeout=45)

    def run(self, account, initialize):
        try:
            marker = ROOT/'runs'/('router-'+str(uuid.uuid4())+'.json')
            self.bridge = self.router.runtime.module.router_bridge_class(self)(account, self, marker, factory=self.router.factory)
            self.bridge.initialize = initialize
            response = self.bridge.rpc('initialize', initialize)
            self.bridge.backend.send({'method':'initialized'})
            self.ready.set_result(response)
            while not self.stopped.is_set():
                try:
                    kind, value, future = self.inbox.get(timeout=.02)
                except queue.Empty:
                    kind = None
                if kind == 'rpc':
                    try: future.set_result(self.bridge.rpc(*value))
                    except Exception as exc: future.set_exception(exc)
                elif kind == 'send':
                    self.router.runtime.refresh()
                    adopt_bridge_runtime(self.bridge, self.router.runtime, self)
                    self.bridge.from_client(value)
                while self.bridge.backend.messages:
                    self.bridge.from_backend(self.bridge.backend.messages.popleft())
                if select.select([self.bridge.backend.process.stdout], [], [], .02)[0]:
                    self.bridge.backend.read()
                self.router.runtime.refresh()
                adopt_bridge_runtime(self.bridge, self.router.runtime, self)
        except Exception as exc:
            if not self.ready.done(): self.ready.set_exception(exc)
            self.router.lane_failed(self, str(exc))
        finally:
            self.stopped.set()
            if self.bridge: self.bridge.close()
            while not self.inbox.empty():
                _, _, future = self.inbox.get_nowait()
                if future and not future.done(): future.set_exception(Error('Backend stopped.'))

    def close(self):
        self.stopped.set()
        self.thread.join(timeout=40)

class MultiRouter:
    def __init__(self, preferred=None, factory=Backend):
        self.preferred, self.factory = preferred, factory
        self.runtime = LiveRuntime()
        self.mutex = threading.RLock()
        self.clients = set()
        self.client_initializes = {}
        self.lanes = set()
        self.sessions = {}
        self.controls = {}
        self.primary = None
        self.requests = {}
        self.approvals = {}
        self.pages = {}
        self.initialize = None
        self.closed = False

    def available(self):
        choices = eligible_accounts()
        if self.preferred in choices:
            choices.remove(self.preferred)
            choices.insert(0, self.preferred)
        if not choices: raise Error('No accounts are ready. Add an account or wait for quota to reset.')
        return choices

    def lane(self, account, control=False, initialize=None):
        if self.closed: raise Error('Router is shutting down.')
        options = dict(initialize or self.initialize)
        options['capabilities'] = dict(options.get('capabilities') or {}, experimentalApi=True)
        lane = RouterLane(self, account, options, control)
        self.lanes.add(lane)
        return lane

    def control(self, account=None):
        name = account or self.primary or self.available()[0]
        if self.primary is None: self.primary = name
        old = self.controls.get(name)
        if old is None or old.stopped.is_set():
            self.controls[name] = self.lane(name, control=True)
        return self.controls[name]

    def reply(self, client, message):
        try: client.send(message)
        except (OSError, EOFError): self.clients.discard(client)

    def notice(self, sid, text):
        # Standard error notification, scoped to the affected conversation.
        with self.mutex:
            for client in list(self.clients):
                self.reply(client, {'method':'error','params':{'threadId':sid, 'willRetry':False,
                    'error':{'message':text,'codexErrorInfo':None,'additionalDetails':None}}})

    def output(self, lane, message):
        with self.mutex:
            for key, approval in list(self.approvals.items()):
                if approval[0] is lane and approval[2] != lane.generation:
                    del self.approvals[key]
            message = dict(message)
            method = message.get('method')
            if 'id' in message and not method:
                pending = self.requests.pop(message['id'], None)
                if pending is None: return
                client, original, owner, requested = pending
                thread = (message.get('result') or {}).get('thread')
                if thread and not lane.control and requested in ('thread/start','thread/resume','thread/fork'):
                    self.sessions[thread['id']] = lane
                message['id'] = original
                if client in self.clients: self.reply(client, message)
                return
            params = message.get('params') or {}
            if not lane.control and method == 'thread/started' and params.get('thread'):
                self.sessions[params['thread']['id']] = lane
            if method and method.startswith('account/') and (not lane.control or lane is not self.controls.get(self.primary)):
                return  # A per-chat switch is not a global Desktop login change.
            if 'id' in message and method:
                original = message['id']
                message['id'] = 'router-approval-'+str(uuid.uuid4())
                self.approvals[message['id']] = (lane, original, lane.generation, message)
            for client in list(self.clients): self.reply(client, message)

    def lane_failed(self, lane, reason):
        with self.mutex:
            for ident, pending in list(self.requests.items()):
                client, original, owner, _ = pending
                if owner is lane:
                    self.reply(client, {'id':original,'error':{'code':-32000,'message':reason}})
                    del self.requests[ident]
            for ident, pending in list(self.approvals.items()):
                if pending[0] is lane: del self.approvals[ident]
            for sid, owner in list(self.sessions.items()):
                if owner is lane: del self.sessions[sid]

    def disconnect(self, client):
        with self.mutex:
            self.clients.discard(client)
            self.client_initializes.pop(client, None)
            # Keep actors alive; replies to departed clients are dropped.
            for ident, pending in list(self.requests.items()):
                if pending[0] is client:
                    self.requests[ident] = (None, *pending[1:])

    def route(self, client, message):
        module = self.runtime.refresh()
        with self.mutex:
            self.__class__ = module.MultiRouter
            if self.factory.__dict__.get('_live_native_backend', False): self.factory = module.Backend
        if self.closed: raise Error('Router is shutting down.')
        method, params = message.get('method'), message.get('params') or {}
        ident = message.get('id')
        if method == 'initialize':
            with self.mutex:
                if self.initialize is None: self.initialize = params
                self.clients.add(client)
                self.client_initializes[client] = params
                lane = self.control()
            response = lane.ready.result(timeout=35)
            with self.mutex:
                self.reply(client, {'id':ident,'result':response})
            return
        if method == 'initialized':
            with self.mutex:
                for lane, original, generation, pending in self.approvals.values():
                    if generation == lane.generation: self.reply(client, pending)
            return
        if client not in self.clients: raise Error('Initialize this connection first.')
        if not method:
            with self.mutex:
                pending = self.approvals.pop(ident, None)
                if pending:
                    lane, original, generation, _ = pending
                    if generation == lane.generation: lane.submit(dict(message, id=original))
            return
        if method in ('account/login/start','account/logout','account/login/cancel'):
            raise Error('Manage router accounts with codex-accounts add/login; Desktop cannot replace the shared account registry.')
        if method == 'thread/list':
            response = self.thread_list(params)
            with self.mutex: self.reply(client, {'id':ident,'result':response})
            return
        if method == 'thread/loaded/list':
            with self.mutex:
                ids = [sid for sid,lane in self.sessions.items() if not lane.stopped.is_set()]
                self.reply(client, {'id':ident,'result':{'data':ids}})
            return
        with self.mutex:
            sid = params.get('threadId')
            lane = self.sessions.get(sid)
            if lane and lane.stopped.is_set(): lane = None
            if method == 'thread/start' or (method == 'thread/fork' and not params.get('ephemeral')):
                account = choose_session(sid)['account'] if sid else self.available()[0]
                lane = self.lane(account, initialize=self.client_initializes[client])
            elif sid and lane is None:
                row = choose_session(sid)
                if method == 'thread/resume':
                    lane = self.lane(row['account'], initialize=self.client_initializes[client])
                    self.sessions[sid] = lane
                elif method.startswith('turn/') or method == 'thread/compact/start':
                    raise Error('Resume this conversation before starting or steering a turn.')
                else:
                    # Metadata/history operations must not acquire a writer or
                    # turn an unloaded conversation into an active session.
                    lane = self.control(row['account'])
            elif lane is None:
                lane = self.control()
            routed = dict(message)
            if 'id' in message:
                routed['id'] = 'router-request-'+str(uuid.uuid4())
                self.requests[routed['id']] = (client, ident, lane, method)
            try: lane.submit(routed)
            except Exception:
                self.requests.pop(routed.get('id'), None)
                raise

    def thread_list(self, params):
        cursor = params.get('cursor')
        limit = params.get('limit') or 25
        if not isinstance(limit,int) or not 1 <= limit <= 1000: raise Error('Invalid thread list limit.')
        with self.mutex:
            now = time.monotonic()
            self.pages = {k:v for k,v in self.pages.items() if v[0]>now}
            if cursor:
                stored = self.pages.pop(cursor, None)
                if stored is None: raise Error('History cursor expired; reload the first page.')
                rows = stored[1]
            else: rows = None
        if rows is None:
            found = {}
            ownership = owners()
            for account in accounts():
                if not (require_account(account)/'auth.json').is_file(): continue
                with self.mutex: lane = self.control(account)
                query = dict(params, cursor=None, limit=100)
                while True:
                    result = lane.call('thread/list', query)
                    for row in result.get('data',[]):
                        sid = row['id']
                        if sid in ownership and ownership[sid] != account: continue
                        if sid not in found or ownership.get(sid)==account: found[sid]=row
                    cursor = result.get('nextCursor')
                    if not cursor: break
                    if len(found)>10000: raise Error('Narrow your history search to fewer than 10000 chats.')
                    query['cursor']=cursor
            key = {'created_at':'createdAt','updated_at':'updatedAt','recency_at':'updatedAt'}.get(params.get('sortKey'),'createdAt')
            rows = sorted(found.values(), key=lambda r:(r.get(key,0),r['id']),reverse=params.get('sortDirection')!='asc')
        next_cursor = None
        if len(rows)>limit:
            next_cursor='router-page-'+str(uuid.uuid4())
            with self.mutex:
                if len(self.pages)>=128: self.pages.pop(next(iter(self.pages)))
                self.pages[next_cursor]=(time.monotonic()+120,rows[limit:])
        return {'data':rows[:limit],'nextCursor':next_cursor}

    def close(self):
        with self.mutex:
            self.closed = True
            lanes = list(self.lanes)
            for lane in lanes: lane.stopped.set()
        for lane in lanes: lane.close()
        self.runtime.close()

class JsonSocket:
    """Native app-server proxy uses newline JSON on its control socket."""
    def __init__(self, sock):
        self.sock, self.buffer = sock, bytearray()
    def send(self, message):
        self.sock.sendall((json.dumps(message)+'\n').encode())
    def read(self):
        data=self.sock.recv(65536)
        if not data: raise EOFError
        self.buffer.extend(data)
        if len(self.buffer)>64*1024*1024: raise Error('Oversized protocol message.')
        result=[]
        while b'\n' in self.buffer:
            line,_,rest=self.buffer.partition(b'\n');self.buffer[:]=rest
            if line.strip(): result.append(json.loads(line))
        return result

class RouterClient:
    def __init__(self, ws):
        self.ws, self.mutex = ws, threading.Lock()
    def send(self, message):
        with self.mutex: self.ws.send(message)

def serve_router(address, preferred=None):
    path=Path(address).expanduser().resolve()
    with lock('router-'+hashlib.sha256(str(path).encode()).hexdigest()[:16]):
        if path.exists() and stat.S_ISSOCK(path.stat().st_mode):
            probe=socket.socket(socket.AF_UNIX)
            try: probe.connect(str(path))
            except ConnectionRefusedError: path.unlink()
            finally: probe.close()
        return _serve_router(address,preferred)

def _serve_router(address, preferred=None):
    path=Path(address).expanduser().resolve()
    if len(str(path).encode())>100: raise Error('Use a shorter Unix socket path (under 100 bytes).')
    if path.exists(): raise Error('Socket path already exists; stop its owner before replacing it.')
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    info = path.parent.stat()
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise Error('Socket parent must be a private directory owned by you (mode 700).')
    private_dir(ROOT/'runs')
    router=MultiRouter(preferred)
    listener=socket.socket(socket.AF_UNIX)
    clients=[]
    stopping=threading.Event()
    def connected(sock):
        client=None
        try:
            sock.settimeout(5)
            client=RouterClient(WebSocket(sock) if sock.recv(1,socket.MSG_PEEK)==b'G' else JsonSocket(sock))
            while not stopping.is_set():
                if not select.select([sock],[],[],.25)[0]: continue
                for message in client.ws.read():
                    try: router.route(client,message)
                    except Exception as exc:
                        if 'id' in message:
                            client.send({'id':message['id'],'error':{'code':-32000,'message':str(exc)}})
        except (EOFError,OSError,Error,ValueError): pass
        finally:
            if client: router.disconnect(client)
            sock.close()
    previous={s:signal.signal(s,lambda *_:stopping.set()) for s in (signal.SIGTERM,signal.SIGINT)}
    try:
        listener.bind(str(path));path.chmod(0o600);listener.listen(16);listener.settimeout(.25)
        print('Multi-session router listening on '+str(path),file=sys.stderr,flush=True)
        while not stopping.is_set():
            router.runtime.refresh()
            try: sock,_=listener.accept()
            except socket.timeout: continue
            thread=threading.Thread(target=connected,args=(sock,),daemon=True)
            clients.append(thread);thread.start()
    finally:
        stopping.set();listener.close();router.close();path.unlink(missing_ok=True)
        for s,handler in previous.items():signal.signal(s,handler)
    return 0


# macOS onboarding owns only its named services and generated SSH alias.
import getpass
import plistlib
import shlex
import stat

DESKTOP_FILE = 'desktop/settings.json'

def desktop_settings():
    settings=read_json(ROOT/DESKTOP_FILE)
    if not settings: raise Error('Run codex-accounts setup first.')
    return settings

def desktop_label(kind):
    digest=hashlib.sha256(str(ROOT).encode()).hexdigest()[:8]
    return 'ai.codex-accounts.'+kind+'.'+digest

def launchctl_loaded(label):
    return subprocess.run(['launchctl','print',f'gui/{os.getuid()}/'+label],
                          stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0

def desktop_service(action):
    if sys.platform!='darwin': raise Error('Desktop onboarding currently supports macOS only.')
    settings=desktop_settings()
    if action=='restart':
        desktop_service('stop')
        return desktop_service('start')
    for kind in ('router','ssh') if action=='start' else ('ssh','router'):
        label=desktop_label(kind)
        loaded=launchctl_loaded(label)
        if action=='start' and not loaded:
            subprocess.run(['launchctl','bootstrap',f'gui/{os.getuid()}',settings['plists'][kind]],check=True)
        elif action=='stop' and loaded:
            subprocess.run(['launchctl','bootout',f'gui/{os.getuid()}/'+label],check=True)
    print('Desktop services '+('started.' if action=='start' else 'stopped. Saved accounts and chats are retained.'))

def desktop_status(as_json=False):
    settings=desktop_settings()
    status={k:settings[k] for k in ('alias','port','account','socket')}
    status['services']={k:launchctl_loaded(desktop_label(k)) for k in ('router','ssh')}
    for kind,address,family in [('router',settings['socket'],socket.AF_UNIX),
                                ('ssh',('127.0.0.1',settings['port']),socket.AF_INET)]:
        sock=socket.socket(family);sock.settimeout(1)
        try:sock.connect(address);status[kind+'_reachable']=True
        except OSError:status[kind+'_reachable']=False
        finally:sock.close()
    if as_json: print(json.dumps(status,indent=2))
    else:
        print('CODEX AUTO')
        for kind in ('router','ssh'):
            print(kind.title()+': '+('ready' if status[kind+'_reachable'] else 'not reachable'))
        print('Desktop hostname: '+settings['alias'])
        print('Account activity: codex-accounts overview --history')
        print('Logs: '+str(ROOT/'desktop/logs'))
    return status

def write_private_text(path,text,mode=0o600):
    private_dir(path.parent)
    fd,temp=tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd,'w') as f:f.write(text)
        os.chmod(temp,mode);os.replace(temp,path)
    finally:
        if os.path.exists(temp):os.unlink(temp)

def desktop_config(account, port, alias, native, home):
    base=ROOT/'desktop'
    digest=hashlib.sha256(str(ROOT).encode()).hexdigest()[:8]
    address=f'/tmp/ca-{os.getuid()}-{digest}/router.sock'
    return dict(format_version=1,account=account,port=port,alias=alias,native=native,socket=address,
                user=getpass.getuser(),launcher=str(executable_path()),python=sys.executable,
                plists={k:str(home/'Library/LaunchAgents'/(desktop_label(k)+'.plist')) for k in ('router','ssh')})

def generate_desktop_files(settings, home):
    base=ROOT/'desktop'
    private_dir(base);private_dir(base/'logs');private_dir(base/'client-home')
    for name in ('host_key','client_key'):
        key=base/name
        if not key.exists():
            subprocess.run(['ssh-keygen','-q','-t','ed25519','-N','','-C','codex-accounts-'+name,'-f',str(key)],check=True)
        if not key.with_suffix('.pub').is_file():raise Error('Missing public key for '+str(key))
    hostkey=(base/'host_key.pub').read_text().split()
    write_private_text(base/'known_hosts',f"[127.0.0.1]:{settings['port']} {hostkey[0]} {hostkey[1]}\n")
    invoke='exec env CODEX_ACCOUNTS_HOME='+shlex.quote(str(ROOT))+' '+shlex.quote(settings['python'])+' '+shlex.quote(settings['launcher'])
    write_private_text(base/'bin/codex','#!/bin/sh\n'+invoke+' desktop-proxy -- "$@"\n',0o700)
    write_private_text(base/'ssh-command','#!/bin/sh\n'+invoke+' desktop-shell\n',0o700)
    path=str(base/'bin')+':'+str(Path(settings['native']).parent)+':/usr/bin:/bin:/usr/sbin:/sbin'
    for name in ('.zshenv','.zprofile'):
        write_private_text(base/name,'export PATH='+shlex.quote(path)+'\n')
    # OpenSSH config accepts quoted paths, including spaces.
    quote=lambda value:'"'+str(value).replace('\\','\\\\').replace('"','\\"')+'"'
    sshd=f'''Port {settings['port']}
ListenAddress 127.0.0.1
HostKey {quote(base/'host_key')}
PidFile {quote(base/'sshd.pid')}
AuthorizedKeysFile {quote(base/'client_key.pub')}
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
UsePAM no
StrictModes yes
AllowUsers {settings['user']}
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
LogLevel ERROR
ForceCommand {shlex.quote(str(base/'ssh-command'))}
'''
    write_private_text(base/'sshd_config',sshd)
    snippet=base/'ssh_config'
    write_private_text(snippet,f'''Host {settings['alias']}
  HostName 127.0.0.1
  User {settings['user']}
  Port {settings['port']}
  IdentityFile {quote(base/'client_key')}
  IdentitiesOnly yes
  ProxyCommand none
  ProxyJump none
  UserKnownHostsFile {quote(base/'known_hosts')}
  StrictHostKeyChecking yes
''')
    config=home/'.ssh/config';include='Include '+quote(snippet)
    old=config.read_text() if config.exists() else ''
    if include not in old.splitlines():
        if config.exists() and not (base/'ssh_config.before').exists():
            write_private_text(base/'ssh_config.before',old)
        write_private_text(config,include+'\n'+old)
    env={'CODEX_ACCOUNTS_HOME':str(ROOT),'CODEX_ACCOUNTS_BINARY':settings['native'],
         'PATH':str(Path(settings['native']).parent)+':/usr/bin:/bin:/usr/sbin:/sbin'}
    commands={'router':[settings['python'],settings['launcher'],'serve','--socket',settings['socket'],'--account',settings['account']],
              'ssh':['/usr/sbin/sshd','-D','-e','-f',str(base/'sshd_config')]}
    for kind,args in commands.items():
        plist=Path(settings['plists'][kind])
        data={'Label':desktop_label(kind),'ProgramArguments':args,'EnvironmentVariables':env,
              'RunAtLoad':True,'KeepAlive':True,'ThrottleInterval':10,'ExitTimeOut':60,'WorkingDirectory':str(base),
              'StandardOutPath':str(base/'logs'/(kind+'.log')),'StandardErrorPath':str(base/'logs'/(kind+'.log'))}
        # Do not change permissions on the user's shared LaunchAgents directory.
        plist.parent.mkdir(parents=True,exist_ok=True)
        fd,temp=tempfile.mkstemp(dir=plist.parent)
        try:
            with os.fdopen(fd,'wb') as f:plistlib.dump(data,f)
            os.chmod(temp,0o600);os.replace(temp,plist)
        finally:
            if os.path.exists(temp):os.unlink(temp)
    atomic_json(ROOT/DESKTOP_FILE,settings)

def setup_desktop(account=None, port=None):
    if port is not None and not 1 <= port <= 65535: raise Error('SSH port must be between 1 and 65535.')
    if sys.platform!='darwin':raise Error('Automatic Desktop setup currently supports macOS only. CLI routing remains available.')
    if not shutil.which('ssh-keygen') or not Path('/usr/sbin/sshd').is_file():raise Error('OpenSSH is required for Desktop setup.')
    prior=read_json(ROOT/DESKTOP_FILE)
    if prior:
        settings=dict(prior)
        changed=(account and account!=prior['account'] or port and port!=prior['port'] or
                 prior['launcher']!=str(executable_path()) or prior['python']!=sys.executable or prior.get('format_version')!=1)
        if changed:
            if any(launchctl_loaded(desktop_label(k)) for k in ('router','ssh')):
                raise Error('Stop services with codex-accounts desktop stop before changing this setup; active chats would otherwise be interrupted.')
            settings.update(format_version=1,account=account or prior['account'],port=port or prior['port'],
                            launcher=str(executable_path()),python=sys.executable)
            generate_desktop_files(settings,Path.home())
    else:
        connected=[n for n in accounts() if (account_home(n)/'auth.json').is_file()]
        if not connected:
            if not sys.stdin.isatty():raise Error('Connect an account first: codex-accounts add NAME; then run codex-accounts setup.')
            print('1. Connect your ChatGPT accounts')
            while True:
                name=input('Account label (for example personal): ').strip()
                login(name,False,create=name not in accounts())
                if input('Add another account? [y/N] ').strip().lower()!='y':break
            connected=[n for n in accounts() if (account_home(n)/'auth.json').is_file()]
        if account:
            if account not in connected:raise Error('Connect this account first: codex-accounts add '+account)
        else:
            print('Checking account availability…',flush=True)
            account=select_ready_account(collect_status())['label']
        native=shutil.which(BINARY)
        if not native:raise Error('Install the Codex CLI first.')
        # Resolve a free loopback port before writing any service configuration.
        probe=socket.socket()
        try:probe.bind(('127.0.0.1',port or 0));port=probe.getsockname()[1]
        finally:probe.close()
        alias='codex-auto'
        resolved=subprocess.run(['ssh','-G',alias],capture_output=True,text=True)
        hostname=next((line.split(None,1)[1] for line in resolved.stdout.splitlines() if line.startswith('hostname ')),alias)
        if hostname!=alias:alias+='-'+hashlib.sha256(str(ROOT).encode()).hexdigest()[:8]
        if any((parent/'.git').exists() for parent in executable_path().parents):
            raise Error('Install first with python3 install.py, then run the installed codex-accounts setup.')
        settings=desktop_config(account,port,alias,str(Path(native).absolute()),Path.home())
        generate_desktop_files(settings,Path.home())
    subprocess.run(['/usr/sbin/sshd','-t','-f',str(ROOT/'desktop/sshd_config')],check=True)
    desktop_service('start')
    deadline=time.monotonic()+15
    last='Services are starting.'
    while time.monotonic()<deadline:
        check=subprocess.run(['ssh','-o','BatchMode=yes','-o','ConnectTimeout=2',settings['alias'],'codex app-server daemon version'],capture_output=True,text=True)
        if check.returncode==0:
            try:
                if json.loads(check.stdout).get('status')=='running':break
            except ValueError:pass
        last=check.stderr.strip();time.sleep(.5)
    else:raise Error('Setup saved, but SSH verification failed: '+last+'. Run codex-accounts desktop status.')
    print('\nReady. Services will start when you log in to this Mac.')
    print('In Codex Desktop → Settings → Connections → SSH, select '+settings['alias']+'.')
    print('If it is not listed, Add a connection: display name Codex Auto; hostname '+settings['alias']+'.')
    print('Leave port and identity blank; the SSH alias supplies both.')
    print('Then add a project on Codex Auto and start a new chat.')
    print('Add more accounts anytime: codex-accounts add NAME')
    print('See usage and assignments: codex-accounts overview')
    return 0

def desktop_shell():
    settings=desktop_settings();base=ROOT/'desktop';env=dict(os.environ)
    for key in AUTH_ENV:env.pop(key,None)
    env.update(CODEX_ACCOUNTS_HOME=str(ROOT),CODEX_ACCOUNTS_BINARY=settings['native'],
               CODEX_HOME=str(base/'client-home'),ZDOTDIR=str(base),
               PATH=str(base/'bin')+':'+str(Path(settings['native']).parent)+':/usr/bin:/bin:/usr/sbin:/sbin')
    os.execve('/bin/zsh',['zsh','-c',os.environ.get('SSH_ORIGINAL_COMMAND') or 'exit 0'],env)

def desktop_proxy(args):
    settings=desktop_settings();native=settings['native'];address=settings['socket']
    if args[:1]==['--']:args=args[1:]
    index=args.index('app-server') if 'app-server' in args else None
    if index is not None:
        rest=args[index+1:]
        if rest[:1]==['daemon']:
            if len(rest)<2 or rest[1] not in ('version','start','bootstrap'):
                raise Error('Use codex-accounts desktop start/stop/restart to manage the router.')
            probe=socket.socket(socket.AF_UNIX)
            try:probe.connect(address)
            finally:probe.close()
            version=subprocess.check_output([native,'--version'],text=True).strip().split()[-1]
            print(json.dumps(dict(status='running',managedCodexPath=str(ROOT/'desktop/bin/codex'),managedCodexVersion=version,
                                  socketPath=address,cliVersion=version,appServerVersion=version)))
            return 0
        if not rest or rest[0] in ('proxy','-c','--config','--listen','--stdio','--analytics-default-enabled'):
            os.execv(native,[native,'app-server','proxy','--sock',address])
    if '--remote' in args:
        index=args.index('--remote')
        if index+1<len(args):args[index+1]='unix://'+address
    # Do not silently start an unmanaged chat outside the router.
    if not args or args[0] in ('login','logout','exec','resume'):
        raise Error('Use the Codex Auto Desktop project or codex-accounts auto for chats; codex-accounts add/login manages accounts.')
    os.execv(native,[native,*args])


